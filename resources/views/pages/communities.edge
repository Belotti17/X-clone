@component('layouts/base', { title: 'Communities' })
    @slot('main')
        <!-- SIDEBAR GAUCHE -->
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="data:image/jpeg;base64," alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li><a href="/timeline" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/535437/home.svg" />Home</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/486828/search.svg" />Explore</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/512576/notification-bell-1398.svg" />Notifications</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/522169/mail.svg" />Messages</a></li>
                    <li><a href="/communities" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/158210/community.svg" />Communities</a></li>
                    <li><a href="/profile/{{ user?.username }}" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/512729/profile-round-1342.svg" />Profile</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/521184/more-horizontal.svg" />More</a></li>
                </ul>
                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
                <div class="user-line" id="userMenu">
                    @if(user?.profile_picture)
                        <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;">
                    @else
                        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
                            {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                        </div>
                    @endif
                    <div class="user-info">
                        <div class="user-name">{{ user?.name || user?.username }}</div>
                        <div class="user-handle">{{ user?.username }}</div>
                    </div>
                    <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
                    <div class="popup-menu" hidden>
                        <form method="POST" action="/logout">
                            {{ csrfField() }}
                            <button type="submit" class="logout">Déconnexion</button>
                        </form>
                    </div>
                </div>
            </nav>
        </header>

        <!-- MAIN GRID -->
        <main class="main">
            <!-- PARTIE CENTRALE : COMMUNITIES -->
            <div id="centerContainer">
                <div class="communities-header">
                    <h1>Communautés</h1>
                    <p>Découvrez et rejoignez des personnes partageant vos centres d'intérêt</p>
                </div>

                <div class="suggestions-grid">
                    @if(suggestions && suggestions.length > 0)
                        @each(suggestion in suggestions)
                            <div class="suggestion-card">
                                <a href="/profile/{{ suggestion.username }}" class="profile-link">
                                    <div class="suggestion-card-avatar">
                                        @if(suggestion.profile_picture)
                                            <img src="{{ suggestion.profile_picture }}" alt="Avatar">
                                        @else
                                            <div class="avatar-circle" style="width: 60px; height: 60px; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 24px;">
                                                {{ suggestion.name ? suggestion.name.charAt(0).toUpperCase() : suggestion.username.charAt(0).toUpperCase() }}
                                            </div>
                                        @endif
                                    </div>
                                </a>
                                <div class="suggestion-card-info">
                                    <a href="/profile/{{ suggestion.username }}" class="profile-link">
                                        <h3>{{ suggestion.name || suggestion.username }}</h3>
                                    </a>
                                    <p class="username">{{ suggestion.username }}</p>
                                    <p class="bio">{{ suggestion.bio ? suggestion.bio : 'Aucune bio' }}</p>
                                </div>
                                <div class="suggestion-card-action">
                                    <form method="POST" action="/follow/{{ suggestion.id }}">
                                        {{ csrfField() }}
                                        <button type="submit" class="follow-btn">Suivre</button>
                                    </form>
                                </div>
                            </div>
                        @end
                    @else
                        <div class="empty-feed">
                            <p>Aucune suggestion pour le moment. Revenez plus tard !</p>
                        </div>
                    @endif
                </div>
            </div>

            <!-- COLONNE DROITE (identique à la timeline) -->
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search"/>
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">Subscribe to unlock new features and if eligible, receive a share of revenue.</p>
                    <button class="btn--secondary">Subscribe</button>
                </div>

                @if (suggestions && suggestions.length > 0)
                    <div id="whoToFollow">
                        <h3>Qui suivre</h3>
                        @each(suggestion in suggestions.slice(0, 5))
                            <div class="suggestion-item">
                                <a href="/profile/{{ suggestion.username }}" class="suggestion-link">
                                    @if(suggestion.profile_picture)
                                        <img src="{{ suggestion.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                    @else
                                        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                            {{ suggestion.name ? suggestion.name.charAt(0).toUpperCase() : suggestion.username.charAt(0).toUpperCase() }}
                                        </div>
                                    @endif
                                </a>
                                <div>
                                    <a href="/profile/{{ suggestion.username }}" class="suggestion-link">
                                        <strong>{{ suggestion.name || suggestion.username }}</strong>
                                    </a>
                                    <span>{{ suggestion.username }}</span>
                                </div>
                                <form method="POST" action="/follow/{{ suggestion.id }}">
                                    {{ csrfField() }}
                                    <button type="submit" class="follow-btn">Suivre</button>
                                </form>
                            </div>
                        @end
                    </div>
                @endif
            </div>
        </main>

        <!-- Modales (inchangées) -->
        <div id="tweetModal" class="modal" style="display:none">...</div>
        <div id="repliesModal" class="modal" style="display:none">...</div>
        <div id="retweetModal" class="modal" style="display:none">...</div>
    @end
@end

<style>
    /* Styles spécifiques à la page Communities */
    .communities-header {
        padding: 20px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .communities-header h1 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 8px;
        color: black;
    }

    .communities-header p {
        color: #6b7280;
        font-size: 14px;
    }

    .suggestions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding: 20px 16px;
    }

    .suggestion-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .suggestion-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .suggestion-card-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .suggestion-card-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .suggestion-card-info h3 {
        font-size: 18px;
        font-weight: 700;
        margin: 0;
        color: black;
    }

    .suggestion-card-info .username {
        color: #6b7280;
        font-size: 14px;
        margin: 4px 0;
    }

    .suggestion-card-info .bio {
        color: #4b5563;
        font-size: 13px;
        margin: 8px 0 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .suggestion-card-action {
        margin-top: 16px;
    }

    .suggestion-card-action .follow-btn {
        background: black;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 9999px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .suggestion-card-action .follow-btn:hover {
        background: #1d9bf0;
    }

    /* Styles pour les liens de profil */
    .profile-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
    }

    .profile-link:hover h3 {
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .suggestions-grid {
            grid-template-columns: 1fr;
            padding: 12px;
        }

        .communities-header {
            padding: 12px;
        }

        .communities-header h1 {
            font-size: 20px;
        }
    }
</style>
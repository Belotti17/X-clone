@component('layouts/base', { title: `${profileUser.name || profileUser.username} (@${profileUser.username})` })
    @slot('main')
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="/assets/icon/X_logo_2023.svg.png" alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li><a href="/timeline" class="nav__link"><img class="nav__icon" src="/assets/icon/home-button_7781676.png" />Home</a></li>
                    <li><a href="/explore" class="nav__link"><img class="nav__icon" src="/assets/icon/search-svgrepo-com.svg" />Explore</a></li>
                    <li><a href="/notifications" class="nav__link"><img class="nav__icon" src="/assets/icon/notification-bell-on-svgrepo-com.svg" />Notifications</a></li>
                    <li><a href="/messages" class="nav__link"><img class="nav__icon" src="/assets/icon/message-mail-email-letter-envelope-svgrepo-com.svg" />Messages</a></li>
                    <li><a href="/grok" class="nav__link"><img class="nav__icon" src="/assets/icon/grok-logo-png_seeklogo-613403.png" />Grok</a></li>
                    <li><a href="/communities" class="nav__link"><img class="nav__icon" src="/assets/icon/users-svgrepo-com.svg" />Communities</a></li>
                    <li><a href="/profile/{{ user?.username }}" class="nav__link"><img class="nav__icon" src="/assets/icon/essential_17219353.png" />Profile</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="/assets/icon/more-circle-svgrepo-com.svg" />More</a></li>
                </ul>
                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
            </nav>

            <div class="user-line">
                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
                    {{ user?.avatarUrl ? '' : (user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U') }}
                    @if(user?.avatarUrl)
                        <img src="{{ user.avatarUrl }}" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                    @endif
                </div>
                <div class="user-info">
                    <div class="user-name">{{ user?.name || user?.username }}</div>
                    <div class="user-handle">@{{ user?.username }}</div>
                </div>
                <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
            </div>
        </header>

        <main class="main">
            <div id="centerContainer">
                <div class="profile-header-sticky">
                    <div class="profile-header-inner">
                        <a href="/timeline" class="profile-back-btn">
                            <svg width="20" height="20" fill="white" viewBox="0 0 24 24"><path d="M7.414 13l5.043 5.04-1.414 1.42L3.586 12l7.457-7.46 1.414 1.42L7.414 11H21v2H7.414z"/></svg>
                        </a>
                        <div>
                            <h1 class="profile-header-name">{{ profileUser.name || profileUser.username }}</h1>
                            <p class="profile-header-tweets">{{ tweets.length }} posts</p>
                        </div>
                    </div>
                </div>

                <div class="profile-banner">
                    @if(profileUser.bannerUrl)
                        <img src="{{ profileUser.bannerUrl }}" class="profile-banner-img">
                    @else
                        <div class="profile-banner-placeholder"></div>
                    @endif
                </div>

                <div class="profile-avatar-section">
                    <div class="profile-avatar-wrapper">
                        @if(profileUser.avatarUrl)
                            <img src="{{ profileUser.avatarUrl }}" class="profile-avatar-img">
                        @else
                            <div class="profile-avatar-circle">
                                {{ profileUser.name ? profileUser.name.charAt(0).toUpperCase() : profileUser.username.charAt(0).toUpperCase() }}
                            </div>
                        @endif
                    </div>
                    <div class="profile-action-btn">
                        @if(currentUser && currentUser.id === profileUser.id)
                            <button onclick="openEditProfileModal()" class="btn-edit-profile">Modifier le profil</button>
                        @else
                            <form method="POST" action="/follow/{{ profileUser.id }}">
                                {{ csrfField() }}
                                <button type="submit" class="btn-follow-profile {{ isFollowing ? 'following' : '' }}">
                                    {{ isFollowing ? 'Abonné' : 'Suivre' }}
                                </button>
                            </form>
                        @endif
                    </div>
                </div>

                <div class="profile-info-section">
                    <div class="name-with-badge">
                        <h2 class="profile-info-name">{{ profileUser.name || profileUser.username }}</h2>
                        <svg class="verify-badge" viewBox="0 0 24 24" width="20" height="20" fill="#1d9bf0"><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.97-.81-4.01s-2.62-1.27-4.01-.81c-.67-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.97-.2-4.01.81s-1.27 2.62-.81 4.01c-1.31.67-2.19 1.91-2.19 3.34s.88 2.67 2.19 3.34c-.46 1.39-.2 2.97.81 4.01s2.62 1.27 4.01.81c.67 1.31 1.91 2.19 3.34 2.19s2.67-.88 3.33-2.19c1.4.46 2.97.2 4.01-.81s1.27-2.62.81-4.01c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2l-3.5-3.5 1.4-1.42 2.1 2.1 5.4-5.46 1.42 1.42-6.82 6.86z"/></svg>
                    </div>
                    <p class="profile-info-username">@{{ profileUser.username }}</p>

                    @if(profileUser.bio)
                        <p class="profile-info-bio">{{ profileUser.bio }}</p>
                    @endif

                    <div class="profile-info-date">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M7 4V3h2v1h6V3h2v1h1.5C19.88 4 21 5.12 21 6.5v12c0 1.38-1.12 2.5-2.5 2.5h-13C4.12 21 3 19.88 3 18.5v-12C3 5.12 4.12 4 5.5 4H7zm0 2H5.5c-.28 0-.5.22-.5.5v12c0 .28.22.5.5.5h13c.28 0 .5-.22.5-.5v-12c0-.28-.22-.5-.5-.5H17v1h-2V6H9v1H7V6zm0 6h2v-2H7v2zm0 4h2v-2H7v2zm4-4h2v-2h-2v2zm0 4h2v-2h-2v2zm4-4h2v-2h-2v2z"/></svg>
                        <span>Inscrit(e) en {{ profileUser.createdAt?.toFormat ? profileUser.createdAt.toFormat('MMMM yyyy') : 'novembre 2023' }}</span>
                    </div>

                    <div class="profile-info-stats">
                        <a href="#" class="profile-stats-link"><span class="profile-stats-number">{{ followingCount || 0 }}</span> Abonnements</a>
                        <a href="#" class="profile-stats-link"><span class="profile-stats-number">{{ followersCount || 0 }}</span> Abonnés</a>
                    </div>
                </div>

                <div class="profile-tabs-container">
                    <div class="profile-tabs-scroll">
                        <a href="#" class="profile-tab active">Posts</a>
                        <a href="#" class="profile-tab">Réponses</a>
                        <a href="#" class="profile-tab">Highlights</a>
                        <a href="#" class="profile-tab">Articles</a>
                        <a href="#" class="profile-tab">Médias</a>
                        <a href="#" class="profile-tab">J'aime</a>
                    </div>
                </div>

                <div class="profile-tweets-list">
                    @if(tweets && tweets.length === 0)
                        <div class="empty-feed">
                            <p>Aucun post pour le moment.</p>
                        </div>
                    @else
                        @each(tweet in tweets)
                            @end
                    @endif
                </div>
            </div>

            <div id="rightContainer">
                </div>
        </main>
    @end
@end

<style>
    /* ========== DESIGN DARK MODE CLONE X ========== */
    body { background-color: #000; }
    .main { background-color: #000; color: #fff; border-left: 1px solid #2f3336; border-right: 1px solid #2f3336; }

    /* En-tête */
    .profile-header-sticky {
        position: sticky; top: 0; z-index: 100;
        background: rgba(0, 0, 0, 0.65); backdrop-filter: blur(12px);
        padding: 0 16px;
    }
    .profile-header-inner { display: flex; align-items: center; gap: 30px; height: 53px; }
    .profile-header-name { font-size: 20px; font-weight: 700; color: #fff; margin: 0; }
    .profile-header-tweets { font-size: 13px; color: #71767b; margin: 0; }

    /* Bannière */
    .profile-banner { height: 200px; width: 100%; background-color: #333; overflow: hidden; }
    .profile-banner-img { width: 100%; height: 100%; object-fit: cover; }
    .profile-banner-placeholder { width: 100%; height: 100%; background: #333; }

    /* Avatar */
    .profile-avatar-section {
        padding: 0 16px; display: flex; justify-content: space-between; align-items: flex-end;
        margin-top: -70px; margin-bottom: 12px;
    }
    .profile-avatar-wrapper {
        width: 140px; height: 140px; border-radius: 50%;
        border: 4px solid #000; background: #000; overflow: hidden;
    }
    .profile-avatar-img { width: 100%; height: 100%; object-fit: cover; }
    .profile-avatar-circle {
        width: 100%; height: 100%; background: #1d9bf0;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 50px; font-weight: bold;
    }

    /* Boutons */
    .btn-edit-profile {
        background: transparent; color: #fff; border: 1px solid #536471;
        padding: 8px 16px; border-radius: 9999px; font-weight: 700; cursor: pointer;
    }
    .btn-edit-profile:hover { background: rgba(239, 243, 244, 0.1); }

    /* Infos */
    .profile-info-section { padding: 0 16px; }
    .name-with-badge { display: flex; align-items: center; gap: 4px; }
    .profile-info-name { font-size: 20px; font-weight: 800; color: #fff; margin: 0; }
    .profile-info-username { color: #71767b; font-size: 15px; margin: 0; }
    .profile-info-bio { color: #fff; margin-top: 12px; font-size: 15px; }
    .profile-info-date { display: flex; align-items: center; gap: 4px; color: #71767b; font-size: 14px; margin-top: 12px; }
    .profile-info-stats { display: flex; gap: 20px; margin-top: 12px; }
    .profile-stats-link { color: #71767b; text-decoration: none; font-size: 14px; }
    .profile-stats-number { color: #fff; font-weight: 700; }

    /* Onglets */
    .profile-tabs-container { border-bottom: 1px solid #2f3336; margin-top: 16px; }
    .profile-tabs-scroll { display: flex; overflow-x: auto; scrollbar-width: none; }
    .profile-tab {
        padding: 16px 20px; color: #71767b; text-decoration: none; font-weight: 600;
        border-bottom: 4px solid transparent; transition: 0.2s;
    }
    .profile-tab.active { color: #fff; border-bottom-color: #1d9bf0; }
    .profile-tab:hover { background: rgba(239, 243, 244, 0.1); }
</style>
<script>
    let currentRetweetId = null;
    let currentReplyId = null;

    function toggleMenu(tweetId) {
        const menu = document.getElementById(`menu-${tweetId}`);
        if (menu) {
            menu.classList.toggle('hidden');
        }
    }

    function openEditProfileModal() {
        document.getElementById('editProfileModal').style.display = 'flex';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
        const replyForm = document.getElementById('replyForm');
        if (replyForm) replyForm.reset();
        const retweetForm = document.getElementById('retweetForm');
        if (retweetForm) retweetForm.reset();
    }

    window.openReplyModal = function(tweetId, element) {
        currentReplyId = tweetId;
        const modal = document.getElementById('replyModal');
        const form = document.getElementById('replyForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/reply`;
            modal.style.display = 'flex';
        }
    };

    window.openRetweetModal = function(tweetId) {
        currentRetweetId = tweetId;
        const modal = document.getElementById('retweetModal');
        const form = document.getElementById('retweetForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/retweet`;
            modal.style.display = 'flex';
        }
    };

    // Fermeture des modales avec la croix
    const closeModalBtns = document.querySelectorAll('.close-modal');
    closeModalBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.modal').forEach(modal => {
                modal.style.display = 'none';
            });
            document.querySelectorAll('.modal form').forEach(form => {
                form.reset();
            });
        });
    });

    // Gestion des likes en AJAX
    document.querySelectorAll('.like-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const btn = form.querySelector('.like-btn');
            const countSpan = btn.querySelector('span');
            try {
                const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': csrfToken || '' },
                    body: formData
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.liked) {
                        btn.classList.add('liked');
                    } else {
                        btn.classList.remove('liked');
                    }
                    if (countSpan) countSpan.textContent = result.likesCount;
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        });
    });
</script>
                                                <span class="text-xs md:text-sm">{{ tweet.$extras?.retweetsCount || 0 }}</span>
                                            </button>
                                            <form method="POST" action="/tweets/{{ tweet.id }}/like" class="like-form">
                                                {{ csrfField() }}

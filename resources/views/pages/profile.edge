                                                    <div class="p-2 rounded-full hover:bg-red-500/10">
                                                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                            <path d="M20.884 13.19c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z"/>
                                                        </svg>
                                                    </div>
                                                    <span class="text-xs md:text-sm">{{ tweet.$extras?.likesCount || 0 }}</span>
                                                </button>
                                            </form>
                                            <button class="flex items-center gap-1 hover:text-blue-500 transition">
                                                <div class="p-2 rounded-full hover:bg-blue-500/10">
                                                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                                                        <path d="M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z"/>
                                                    </svg>

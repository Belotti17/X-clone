                        @end
                    @endif
                </div>
            </div>

            <!-- COLONNE DROITE - Identique à votre timeline -->
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search" />
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">
                        Subscribe to unlock new features and if eligible, receive a share of revenue.
                    </p>
                    <button class="btn--secondary">Subscribe</button>
                </div>

                @if (suggestions && suggestions.length > 0)
                    <div id="whoToFollow">
                        <h3>Qui suivre</h3>
                        @each(suggestion in suggestions)
                            <div class="suggestion-item">
                                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                    {{ suggestion.name ? suggestion.name.charAt(0).toUpperCase() : suggestion.username?.charAt(0).toUpperCase() || 'U' }}
                                </div>
                                <div>
                                    <strong>{{ suggestion.name || suggestion.username }}</strong>
                                    <span>@{{ suggestion.username }}</span>
                                </div>
                                <form method="POST" action="/follow/{{ suggestion.id }}">
                                    {{ csrfField() }}
                                    <button type="submit" class="follow-btn">Suivre</button>
                                </form>
                            </div>
                        @end
                    </div>
                @endif
            </div>
        </main>

        <!-- Modales -->
        <div id="editProfileModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('editProfileModal')">&times;</button>
                <h3>Modifier le profil</h3>
                <form method="POST" action="/profile">
                    {{ csrfField() }}
                    <input type="hidden" name="_method" value="PUT">
                    <div class="field">
                        <input type="text" name="name" placeholder="Nom" value="{{ profileUser.name || '' }}">
                    </div>
                    <div class="field">
                        <textarea name="bio" placeholder="Bio" rows="3">{{ profileUser.bio || '' }}</textarea>
                    </div>
                    <button type="submit">Enregistrer</button>
                </form>
            </div>
        </div>

        <div id="replyModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('replyModal')">&times;</button>
                <h3>Répondre au tweet</h3>
                <form id="replyForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Votre réponse..." maxlength="280" required></textarea>
                    <button type="submit">Répondre</button>
                </form>
            </div>
        </div>

        <div id="retweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('retweetModal')">&times;</button>
                <h3>Retweeter</h3>
                <form id="retweetForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Ajouter un commentaire (optionnel)"></textarea>
                    <button type="submit">Retweeter</button>
                </form>
            </div>
        </div>
    @end
@end

<style>
    /* Styles spécifiques au profil */
    .edit-profile-btn {
        border: 1px solid #e5e7eb;
        background: white;
        color: black;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 9999px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s;
    }

    .edit-profile-btn:hover {
        background: #f3f4f6;
    }

    .follow-profile-btn {
        background: black;
        color: white;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 9999px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
    }

    .follow-profile-btn:hover {
        background: #1d9bf0;
    }

    .follow-profile-btn.following {
        background: transparent;
        border: 1px solid #e5e7eb;
        color: black;
    }

    .follow-profile-btn.following:hover {
        background: rgba(29, 155, 240, 0.1);
        border-color: #1d9bf0;
        color: #1d9bf0;
    }

    .profile-tab {
        flex-shrink: 0;
        padding: 16px 20px;
        font-weight: 500;
        font-size: 15px;
        color: #6b7280;
        text-decoration: none;
        transition: all 0.2s;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
    }

    .profile-tab:hover {
        background: rgba(29, 155, 240, 0.1);
    }

    .profile-tab.active {
        color: #1d9bf0;
        border-bottom-color: #1d9bf0;
    }

    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }

    .tweet-item {
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
        transition: background 0.2s;
    }

    .tweet-item:hover {
        background: rgba(0, 0, 0, 0.02);
    }
</style>

<script>
    // Variables globales
    let currentRetweetId = null;
    let currentReplyId = null;

    function toggleMenu(tweetId) {
        const menu = document.getElementById(`menu-${tweetId}`);
        if (menu) menu.classList.toggle('hidden');
    }

    function openEditProfileModal() {
        document.getElementById('editProfileModal').style.display = 'flex';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
        const replyForm = document.getElementById('replyForm');
        if (replyForm) replyForm.reset();
        const retweetForm = document.getElementById('retweetForm');
        if (retweetForm) retweetForm.reset();
    }

    window.openReplyModal = function(tweetId, element) {
        currentReplyId = tweetId;
        const modal = document.getElementById('replyModal');
        const form = document.getElementById('replyForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/reply`;
            modal.style.display = 'flex';
        }
    };

    window.openRetweetModal = function(tweetId) {
        currentRetweetId = tweetId;
        const modal = document.getElementById('retweetModal');
        const form = document.getElementById('retweetForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/retweet`;
            modal.style.display = 'flex';
        }
    };

    // Fermeture des modales avec la croix
    const closeModalBtns = document.querySelectorAll('.close-modal');
    closeModalBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.modal').forEach(modal => {
                modal.style.display = 'none';
            });
            document.querySelectorAll('.modal form').forEach(form => {
                form.reset();
            });
        });
    });

    // Gestion des likes en AJAX
    document.querySelectorAll('.like-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const btn = form.querySelector('button');
            const countSpan = btn.querySelector('span:last-child');
            try {
                const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': csrfToken || '' },
                    body: formData
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.liked) {
                        btn.classList.add('text-red-500');
                        btn.classList.remove('text-gray-500');
                    } else {
                        btn.classList.remove('text-red-500');
                        btn.classList.add('text-gray-500');
                    }
                    if (countSpan) countSpan.textContent = result.likesCount;
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        });
    });
</script>
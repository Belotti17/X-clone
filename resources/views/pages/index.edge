@component('layouts/base', { title: 'X-clone' })
    @slot('main')
        <!-- SIDEBAR GAUCHE -->
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="/assets/icon/X_logo_2023.svg.png" alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li>
                        <a href="/timeline" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/home-button_7781676.png" />Home
                        </a>
                    </li>
                    <li>
                        <a href="/explore" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/search-svgrepo-com.svg" />Explore
                        </a>
                    </li>
                    <li>
                        <a href="/notifications" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/notification-bell-on-svgrepo-com.svg" />Notifications
                        </a>
                    </li>
                    <li>
                        <a href="/messages" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/message-mail-email-letter-envelope-svgrepo-com.svg" />Messages
                        </a>
                    </li>
                    <li>
                        <a href="/grok" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/grok-logo-png_seeklogo-613403.png" />Grok
                        </a>
                    </li>
                    <li>
                        <a href="/communities" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/users-svgrepo-com.svg" />Communities
                        </a>
                    </li>
                    <li>
                        <a href="/profile/{{ user?.username }}" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/essential_17219353.png" />Profile
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="/assets/icon/more-circle-svgrepo-com.svg" />More
                        </a>
                    </li>
                </ul>

                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
            </nav>

            <div class="user-line">
                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
                    {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                </div>
                <div class="user-info">
                    <div class="user-name">{{ user?.name || user?.username }}</div>
                    <div class="user-handle">@{{ user?.username }}</div>
                </div>
                <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
                <div class="popup-menu" hidden>
                    <form method="POST" action="/logout">
                        {{ csrfField() }}
                        <button type="submit" class="logout">Déconnexion</button>
                    </form>
                </div>
            </div>
        </header>

        <!-- MAIN GRID -->
        <main class="main">
            <div id="centerContainer">
                <div class="tabs">
                    <ul class="tabs__list">
                        <li><a href="/timeline" class="tabs__link active">For you</a></li>
                        <li><a href="/following" class="tabs__link">Following</a></li>
                    </ul>
                </div>

                {{-- Messages flash stylisés comme un tweet --}}
                @if (flashMessages.has('success'))
                    <div class="tweet-flash success">
                        <div class="tweet-flash-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            </svg>
                        </div>
                        <div class="tweet-flash-content">
                            @each(message in flashMessages.get('success'))
                                <p>{{ message }}</p>
                            @end
                        </div>
                        <button class="tweet-flash-close" onclick="this.parentElement.remove()">×</button>
                    </div>
                @endif

                @if (flashMessages.has('error'))
                    <div class="tweet-flash error">
                        <div class="tweet-flash-icon">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            </svg>
                        </div>
                        <div class="tweet-flash-content">
                            @each(message in flashMessages.get('error'))
                                <p>{{ message }}</p>
                            @end
                        </div>
                        <button class="tweet-flash-close" onclick="this.parentElement.remove()">×</button>
                    </div>
                @endif

                <div class="addtwets">
                    <div class="tweet-box">
                        <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 20px;">
                            {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                        </div>
                        <div class="tweet-content">
                            <form id="tweetForm" method="POST" action="/tweets" enctype="multipart/form-data">
                                {{ csrfField() }}
                                <textarea name="content" placeholder="What’s happening?" maxlength="280"></textarea>
                                
                                {{-- Input file pour image ET vidéo --}}
                                <input type="file" id="mediaInput" name="media" accept="image/*,video/*" style="display:none" />
                                
                                {{-- Prévisualisation du média --}}
                                <div id="mediaPreview" style="display:none; margin-top: 10px;">
                                    <img id="previewImg" style="max-width: 100%; border-radius: 16px; display:none;" />
                                    <video id="previewVideo" style="max-width: 100%; border-radius: 16px; display:none;" controls></video>
                                    <button type="button" id="removeMedia" style="margin-top: 5px; background: red; color: white; border: none; padding: 4px 8px; border-radius: 20px; cursor: pointer;">Supprimer</button>
                                </div>
                                
                                <div class="tweet-actions">
                                    <div class="tweet-icons">
                                        <button type="button" class="icon-btn" id="uploadMediaBtn">
                                            <img src="/assets/icon/image-1-svgrepo-com.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="/assets/icon/gif-svgrepo-com.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="/assets/icon/grok-logo-png_seeklogo-613403.png" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="/assets/icon/setting-svgrepo-com.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="/assets/icon/emoji-smile-svgrepo-com.svg" />
                                        </button>
                                    </div>
                                    <button type="submit" id="tweet-post">Post</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="feedContainer">
                    @if (tweets && tweets.length === 0)
                        <div class="empty-feed">
                            <p>Aucun tweet à afficher. Suivez des utilisateurs pour voir leurs tweets !</p>
                        </div>
                    @else
                        @each(tweet in tweets)
                            <div class="tweet-item" data-tweet-id="{{ tweet.id }}">
                                <div class="tweet-header">
                                    <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px;">
                                        {{ tweet.user?.name ? tweet.user.name.charAt(0).toUpperCase() : tweet.user?.username?.charAt(0).toUpperCase() || 'U' }}
                                    </div>
                                    <div class="tweet-user-info">
                                        <strong>{{ tweet.user?.name || tweet.user?.username }}</strong>
                                        <span class="username">@{{ tweet.user?.username }}</span>
                                        <span class="time">· {{ tweet.createdAt?.toFormat ? tweet.createdAt.toFormat('dd/MM/yyyy HH:mm') : tweet.createdAt }}</span>
                                    </div>

                                    @if (tweet.userId === user?.id)
                                        <form method="POST" action="/tweets/{{ tweet.id }}/delete" class="delete-form" onsubmit="return confirm('Supprimer ce tweet ?')">
                                            {{ csrfField() }}
                                            <button type="submit" class="delete-btn" title="Supprimer">
                                                <img src="assets/icon/delete.svg" alt="Supprimer" />
                                            </button>
                                        </form>
                                    @endif
                                </div>

                                <div class="tweet-content">
                                    <p>{{ tweet.content }}</p>
                                    @if (tweet.image)
                                        <img src="{{ tweet.image }}" class="tweet-image" />
                                    @endif
                                    @if (tweet.video)
                                        <video src="{{ tweet.video }}" class="tweet-video" controls style="max-width: 100%; border-radius: 16px;"></video>
                                    @endif
                                </div>

                                {{-- Nouvelle disposition des boutons d'interaction --}}
                                <div class="tweet-interactions">
                                    <div class="interaction-group">
                                        <form method="POST" action="/tweets/{{ tweet.id }}/like" class="like-form">
                                            {{ csrfField() }}
                                            <button type="submit" class="interaction-btn like-btn {{ tweet.userLiked ? 'liked' : '' }}">
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                    <path d="M12 21.638h-.014C9.403 21.59 1.95 14.856 1.95 8.478c0-3.064 2.525-5.754 5.403-5.754 2.137 0 3.776 1.478 4.647 2.822.87-1.344 2.51-2.822 4.647-2.822 2.878 0 5.403 2.69 5.403 5.754 0 6.376-7.454 13.11-10.037 13.157H12z"/>
                                                </svg>
                                                <span class="interaction-count">{{ tweet.$extras?.likesCount || 0 }}</span>
                                            </button>
                                        </form>
                                    </div>
                                    
                                    <div class="interaction-group">
                                        <button class="interaction-btn reply-btn" onclick="openReplyModal({{ tweet.id }})">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                <path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01z"/>
                                            </svg>
                                            <span class="interaction-count">{{ tweet.$extras?.repliesCount || 0 }}</span>
                                        </button>
                                    </div>
                                    
                                    <div class="interaction-group">
                                        <button class="interaction-btn retweet-btn" onclick="openRetweetModal({{ tweet.id }})">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                <path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/>
                                            </svg>
                                            <span class="interaction-count">{{ tweet.$extras?.retweetsCount || 0 }}</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        @end
                    @endif
                </div>
            </div>
            
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search" />
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">
                        Subscribe to unlock new features and if eligible, receive a share of revenue.
                    </p>
                    <button class="btn--secondary">Subscribe</button>
                </div>

                {{-- Suggestions de comptes à suivre --}}
                @if (suggestions && suggestions.length > 0)
                    <div id="whoToFollow">
                        <h3>Qui suivre</h3>
                        @each(suggestion in suggestions)
                            <div class="suggestion-item">
                                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                    {{ suggestion.name ? suggestion.name.charAt(0).toUpperCase() : suggestion.username?.charAt(0).toUpperCase() || 'U' }}
                                </div>
                                <div>
                                    <strong>{{ suggestion.name || suggestion.username }}</strong>
                                    <span>@{{ suggestion.username }}</span>
                                </div>
                                <form method="POST" action="/follow/{{ suggestion.id }}">
                                    {{ csrfField() }}
                                    <button type="submit" class="follow-btn">Suivre</button>
                                </form>
                            </div>
                        @end
                    </div>
                @endif
            </div>
        </main>

        {{-- Modale pour poster un tweet --}}
        <div id="tweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('tweetModal')">&times;</button>
                <h3>Nouveau tweet</h3>
                <form id="modalTweetForm" method="POST" action="/tweets">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="What’s happening?" maxlength="280"></textarea>
                    <button type="submit">Poster</button>
                </form>
            </div>
        </div>

        {{-- Modale pour répondre --}}
        <div id="replyModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('replyModal')">&times;</button>
                <h3>Répondre au tweet</h3>
                <form id="replyForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Votre réponse..." maxlength="280" required></textarea>
                    <button type="submit">Répondre</button>
                </form>
            </div>
        </div>

        {{-- Modale pour retweet --}}
        <div id="retweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('retweetModal')">&times;</button>
                <h3>Retweeter</h3>
                <form id="retweetForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Ajouter un commentaire (optionnel)"></textarea>
                    <button type="submit">Retweeter</button>
                </form>
            </div>
        </div>
    @end
@end

<style>
    /* Position relative pour le user-line */
    .user-line {
        position: relative;
        display: flex;
        align-items: center;
        padding: 12px;
        max-width: 350px;
    }

    /* Style du popup-menu comme sur X */
    .popup-menu {
        position: absolute;
        bottom: 70px;
        left: 20px;
        background: #000000;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        min-width: 180px;
        z-index: 1000;
        border: 1px solid #2f3336;
        overflow: hidden;
    }
    
    .popup-menu form {
        margin: 0;
    }
    
    .popup-menu .logout {
        width: 100%;
        padding: 12px 16px;
        background: transparent;
        border: none;
        color: #f4212e;
        font-size: 15px;
        font-weight: 500;
        text-align: left;
        cursor: pointer;
        transition: background 0.2s ease;
        font-family: inherit;
    }
    
    .popup-menu .logout:hover {
        background: rgba(244, 33, 46, 0.1);
    }
    
    .user-menu {
        background: transparent;
        border: none;
        color: #71767b;
        font-size: 22px;
        cursor: pointer;
        padding: 6px 10px;
        border-radius: 9999px;
        margin-left: auto;
    }
    
    .user-menu:hover {
        background: rgba(29, 155, 240, 0.15);
        color: #1d9bf0;
    }

    /* Nouveau style pour les interactions des tweets */
    .tweet-interactions {
        display: flex;
        justify-content: space-between;
        max-width: 425px;
        margin-top: 12px;
    }

    .interaction-group {
        flex: 1;
        display: flex;
        justify-content: center;
    }

    .interaction-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: none;
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        padding: 6px 12px;
        border-radius: 9999px;
        transition: all 0.2s ease;
    }

    .interaction-btn svg {
        transition: all 0.2s ease;
    }

    .interaction-count {
        font-size: 13px;
        color: #6b7280;
    }

    /* Bouton Like */
    .like-btn {
        color: #6b7280;
    }

    .like-btn:hover {
        color: #f91880;
        background-color: rgba(249, 24, 128, 0.1);
    }

    .like-btn.liked {
        color: #f91880;
    }

    .like-btn.liked .interaction-count {
        color: #f91880;
    }

    /* Bouton Reply */
    .reply-btn:hover {
        color: #1d9bf0;
        background-color: rgba(29, 155, 240, 0.1);
    }

    /* Bouton Retweet */
    .retweet-btn:hover {
        color: #00ba7c;
        background-color: rgba(0, 186, 124, 0.1);
    }

    /* Suppression de l'ancien style des actions */
    .tweet-actions-bar {
        display: none;
    }

    .tweet-stats {
        display: none;
    }

    /* ==================== STYLE DES MESSAGES FLASH (COMME UN TWEET) ==================== */
    .tweet-flash {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        margin-bottom: 16px;
        background: #000000;
        border-radius: 16px;
        border: 1px solid #2f3336;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        font-size: 14px;
        font-weight: 400;
        color: #e7e9ea;
        animation: fadeIn 0.3s ease;
    }

    .tweet-flash.success {
        border-left: 4px solid #00ba7c;
    }

    .tweet-flash.error {
        border-left: 4px solid #f4212e;
    }

    .tweet-flash-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #1d9bf0;
    }

    .tweet-flash.success .tweet-flash-icon {
        background: #00ba7c;
    }

    .tweet-flash.error .tweet-flash-icon {
        background: #f4212e;
    }

    .tweet-flash-icon svg {
        width: 18px;
        height: 18px;
        color: white;
    }

    .tweet-flash-content {
        flex: 1;
        text-align: left;
    }

    .tweet-flash-content p {
        margin: 0;
        line-height: 1.4;
    }

    .tweet-flash-close {
        background: transparent;
        border: none;
        color: #71767b;
        font-size: 20px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 9999px;
        transition: all 0.2s;
    }

    .tweet-flash-close:hover {
        color: #e7e9ea;
        background: rgba(113, 118, 123, 0.1);
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    // Attendre que le DOM soit complètement chargé
    document.addEventListener('DOMContentLoaded', function() {
        // ==================== GESTION DE L'UPLOAD D'IMAGE/VIDÉO ====================
        const uploadMediaBtn = document.getElementById('uploadMediaBtn');
        const mediaInput = document.getElementById('mediaInput');
        const tweetForm = document.getElementById('tweetForm');
        const mediaPreview = document.getElementById('mediaPreview');
        const previewImg = document.getElementById('previewImg');
        const previewVideo = document.getElementById('previewVideo');
        const removeMediaBtn = document.getElementById('removeMedia');
        let currentMediaFile = null;
        let currentMediaType = null;
        
        // Bouton pour ouvrir la sélection de média
        if (uploadMediaBtn && mediaInput) {
            uploadMediaBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                mediaInput.click();
            });
            
            // Quand un média est sélectionné
            mediaInput.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    currentMediaFile = this.files[0];
                    currentMediaType = this.files[0].type;
                    const reader = new FileReader();
                    
                    reader.onload = function(e) {
                        if (currentMediaType.startsWith('image/')) {
                            previewImg.style.display = 'block';
                            previewVideo.style.display = 'none';
                            previewImg.src = e.target.result;
                        } else if (currentMediaType.startsWith('video/')) {
                            previewImg.style.display = 'none';
                            previewVideo.style.display = 'block';
                            previewVideo.src = e.target.result;
                        }
                        mediaPreview.style.display = 'block';
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
            
            // Bouton pour supprimer le média
            if (removeMediaBtn) {
                removeMediaBtn.addEventListener('click', function() {
                    mediaInput.value = '';
                    mediaPreview.style.display = 'none';
                    previewImg.src = '';
                    previewVideo.src = '';
                    previewImg.style.display = 'none';
                    previewVideo.style.display = 'none';
                    currentMediaFile = null;
                    currentMediaType = null;
                });
            }
        }
        
        // Soumission du formulaire AVEC ou SANS média
        if (tweetForm) {
            tweetForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const textarea = document.querySelector('#tweetForm textarea');
                const content = textarea ? textarea.value : '';
                
                if (!content || content.trim().length === 0) {
                    showFlashMessage('error', 'Le tweet ne peut pas être vide');
                    return;
                }
                
                const formData = new FormData();
                formData.append('content', content);
                
                if (currentMediaFile) {
                    formData.append('media', currentMediaFile);
                }
                
                const submitBtn = document.getElementById('tweet-post');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Envoi...';
                }
                
                try {
                    const csrfToken = document.querySelector('input[name="_csrf"]');
                    const response = await fetch('/tweets', {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken ? csrfToken.value : ''
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        if (textarea) textarea.value = '';
                        if (mediaInput) mediaInput.value = '';
                        if (mediaPreview) mediaPreview.style.display = 'none';
                        if (previewImg) previewImg.src = '';
                        if (previewVideo) previewVideo.src = '';
                        currentMediaFile = null;
                        currentMediaType = null;
                        
                        showFlashMessage('success', 'Tweet publié avec succès !');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        const error = await response.json();
                        showFlashMessage('error', error.message || 'Erreur lors de la publication');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Post';
                        }
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                    showFlashMessage('error', 'Erreur de connexion');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Post';
                    }
                }
            });
        }
        
        // ==================== MENU UTILISATEUR (POPUP) ====================
        const menuBtn = document.querySelector('.user-menu');
        const popupMenu = document.querySelector('.popup-menu');
        
        if (menuBtn && popupMenu) {
            // Ouvrir/fermer le popup au clic sur le bouton
            menuBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                const isHidden = popupMenu.getAttribute('hidden') !== null;
                if (isHidden) {
                    popupMenu.removeAttribute('hidden');
                } else {
                    popupMenu.setAttribute('hidden', '');
                }
            });
            
            // Fermer le popup quand on clique ailleurs
            document.addEventListener('click', function(e) {
                if (!menuBtn.contains(e.target) && !popupMenu.contains(e.target)) {
                    popupMenu.setAttribute('hidden', '');
                }
            });
        }
        
        // ==================== DÉCONNEXION ====================
        // Pas de JavaScript qui bloque, le formulaire s'envoie normalement
        // Le formulaire de déconnexion fonctionne avec la soumission classique
        
        // ==================== FONCTIONS POUR LES MODALES ====================
        function openReplyModal(tweetId) {
            const modal = document.getElementById('replyModal');
            const form = document.getElementById('replyForm');
            if (modal && form) {
                form.action = '/tweets/' + tweetId + '/reply';
                modal.style.display = 'flex';
            }
        }
        
        function openRetweetModal(tweetId) {
            const modal = document.getElementById('retweetModal');
            const form = document.getElementById('retweetForm');
            if (modal && form) {
                form.action = '/tweets/' + tweetId + '/retweet';
                modal.style.display = 'flex';
            }
        }
        
        window.openReplyModal = openReplyModal;
        window.openRetweetModal = openRetweetModal;
        
        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.style.display = 'none';
            }
            const replyForm = document.getElementById('replyForm');
            if (replyForm) replyForm.reset();
            const retweetFormElem = document.getElementById('retweetForm');
            if (retweetFormElem) retweetFormElem.reset();
        }
        
        window.closeModal = closeModal;
        
        // Fermeture des modales avec la croix
        const closeModalBtns = document.querySelectorAll('.close-modal');
        closeModalBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.modal').forEach(modal => {
                    modal.style.display = 'none';
                });
                document.querySelectorAll('.modal form').forEach(form => {
                    form.reset();
                });
            });
        });
        
        // Fermer la modale en cliquant à l'extérieur
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.style.display = 'none';
                    const form = modal.querySelector('form');
                    if (form) form.reset();
                }
            });
        });
        
        // ==================== GESTION DES RÉPONSES ====================
        const replyFormElem = document.getElementById('replyForm');
        if (replyFormElem) {
            replyFormElem.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const url = this.action;
                const content = formData.get('content');
                
                if (!content || content.trim().length === 0) {
                    showFlashMessage('error', 'La réponse ne peut pas être vide');
                    return;
                }
                
                const submitBtn = this.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Envoi...';
                }
                
                try {
                    const csrfToken = document.querySelector('input[name="_csrf"]');
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken ? csrfToken.value : ''
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        document.getElementById('replyModal').style.display = 'none';
                        showFlashMessage('success', 'Réponse publiée avec succès !');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        const error = await response.json();
                        showFlashMessage('error', error.message || 'Erreur lors de la publication');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Répondre';
                        }
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                    showFlashMessage('error', 'Erreur de connexion');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Répondre';
                    }
                }
            });
        }
        
        // ==================== GESTION DES RETWEETS ====================
        const retweetFormElem = document.getElementById('retweetForm');
        if (retweetFormElem) {
            retweetFormElem.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const url = this.action;
                
                const submitBtn = this.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Envoi...';
                }
                
                try {
                    const csrfToken = document.querySelector('input[name="_csrf"]');
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken ? csrfToken.value : ''
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        document.getElementById('retweetModal').style.display = 'none';
                        showFlashMessage('success', 'Retweet effectué !');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        const error = await response.json();
                        showFlashMessage('error', error.message || 'Erreur lors du retweet');
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Retweeter';
                        }
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                    showFlashMessage('error', 'Erreur de connexion');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Retweeter';
                    }
                }
            });
        }

        // ==================== GESTION DES LIKES (AJAX) ====================
        document.querySelectorAll('.like-form').forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const url = form.action;
                
                const btn = form.querySelector('.interaction-btn');
                const countSpan = btn.querySelector('.interaction-count');
                
                try {
                    const csrfToken = document.querySelector('input[name="_csrf"]');
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken ? csrfToken.value : ''
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        
                        if (result.liked) {
                            btn.classList.add('liked');
                        } else {
                            btn.classList.remove('liked');
                        }
                        
                        if (countSpan) {
                            countSpan.textContent = result.likesCount;
                        }
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                }
            });
        });
        
        // ==================== FONCTION POUR AFFICHER LES MESSAGES FLASH ====================
        function showFlashMessage(type, message) {
            // Supprimer les anciens messages flash
            const existingFlashes = document.querySelectorAll('.tweet-flash');
            existingFlashes.forEach(flash => flash.remove());
            
            const flash = document.createElement('div');
            flash.className = `tweet-flash ${type}`;
            
            let iconSvg = '';
            if (type === 'success') {
                iconSvg = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`;
            } else {
                iconSvg = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`;
            }
            
            flash.innerHTML = `
                <div class="tweet-flash-icon">${iconSvg}</div>
                <div class="tweet-flash-content"><p>${message}</p></div>
                <button class="tweet-flash-close">×</button>
            `;
            
            // Insérer en haut du centerContainer
            const centerContainer = document.getElementById('centerContainer');
            const tabs = document.querySelector('.tabs');
            
            if (centerContainer && tabs) {
                centerContainer.insertBefore(flash, tabs.nextSibling);
            } else {
                document.body.insertBefore(flash, document.body.firstChild);
            }
            
            // Fermeture manuelle
            const closeBtn = flash.querySelector('.tweet-flash-close');
            closeBtn.addEventListener('click', () => {
                flash.remove();
            });
            
            // Auto-fermeture après 3 secondes
            setTimeout(() => {
                if (flash && document.body.contains(flash)) {
                    flash.remove();
                }
            }, 3000);
        }
        
        window.showFlashMessage = showFlashMessage;
        
        // ==================== MODALE POUR POSTER UN TWEET ====================
        const openModalBtn = document.getElementById('openTweetModal');
        const tweetModal = document.getElementById('tweetModal');
        if (openModalBtn && tweetModal) {
            openModalBtn.addEventListener('click', () => {
                tweetModal.style.display = 'flex';
            });
        }
        
        const modalTweetForm = document.getElementById('modalTweetForm');
        if (modalTweetForm) {
            modalTweetForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const content = formData.get('content');
                
                if (!content || content.trim().length === 0) {
                    showFlashMessage('error', 'Le tweet ne peut pas être vide');
                    return;
                }

                const submitBtn = this.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Envoi...';
                }
                
                try {
                    const csrfToken = document.querySelector('input[name="_csrf"]');
                    const response = await fetch('/tweets', {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfToken ? csrfToken.value : ''
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        document.getElementById('tweetModal').style.display = 'none';
                        showFlashMessage('success', 'Tweet publié avec succès !');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.textContent = 'Poster';
                        }
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                    showFlashMessage('error', 'Erreur lors de la publication');
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Poster';
                    }
                }
            });
        }
    });
</script>
            </div>
        </main>

        {{-- Modale pour poster un tweet --}}
        <div id="tweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('tweetModal')">&times;</button>
                <h3>Nouveau tweet</h3>
                <form id="modalTweetForm" method="POST" action="/tweets">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="What’s happening?" maxlength="280"></textarea>
                    <button type="submit">Poster</button>
                </form>
            </div>
        </div>

        {{-- MODALE POUR LES COMMENTAIRES (REPLIES) --}}
        <div id="repliesModal" class="modal" style="display:none">
            <div class="modal-content modal-replies">
                <button class="close-modal" onclick="closeModal('repliesModal')">&times;</button>
                <h3>Réponses</h3>
                
                {{-- Tweet original --}}
                <div id="originalTweetPreview" class="original-tweet-preview"></div>
                
                {{-- Liste des commentaires --}}
                <div id="repliesList" class="replies-list-modal"></div>
                
                {{-- Formulaire pour commenter --}}
                <div class="reply-form-modal">
                    <div class="reply-input-modal">
                        <a href="/profile/{{ user?.username }}" class="profile-link">
                            @if(user?.profile_picture)
                                <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                            @else
                                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 16px;">
                                    {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                                </div>
                            @endif
                        </a>
                        <textarea id="replyContent" placeholder="Écrire une réponse..." maxlength="280"></textarea>
                    </div>
                    <div class="reply-actions-modal">
                        <button class="cancel-reply-modal" onclick="closeModal('repliesModal')">Annuler</button>
                        <button class="submit-reply-modal" id="submitReplyBtn">Répondre</button>
                    </div>
                </div>
            </div>
        </div>

        {{-- Modale pour retweet --}}
        <div id="retweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('retweetModal')">&times;</button>
                <h3>Retweeter</h3>
                <form id="retweetForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Ajouter un commentaire (optionnel)"></textarea>
                    <button type="submit">Retweeter</button>
                </form>
            </div>
        </div>

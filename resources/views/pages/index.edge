@component('layouts/base', { title: 'X-clone' })
    @slot('main')
        <!-- SIDEBAR GAUCHE -->
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="data:image/jpeg;base64," alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li>
                        <a href="/timeline" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/535437/home.svg" />Home
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/486828/search.svg" />Explore
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512576/notification-bell-1398.svg" />Notifications
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/522169/mail.svg" />Messages
                        </a>
                    </li>
                    
                    <li>
                        <a href="/communities" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/158210/community.svg" />Communities
                        </a>
                    </li>
                    <li>
                        <a href="/profile/{{ user?.username }}" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512729/profile-round-1342.svg" />Profile
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/521184/more-horizontal.svg" />More
                        </a>
                    </li>
                </ul>

                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
                <div class="user-line" id="userMenu">
                    @if(user?.profile_picture)
                        <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;">
                    @else
                        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
                            {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                        </div>
                    @endif
                    <div class="user-info">
                        <div class="user-name">{{ user?.name || user?.username }}</div>
                        <div class="user-handle">{{ user?.username }}</div>
                    </div>
                    <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
                    <div class="popup-menu" hidden>
                        <form method="POST" action="/logout">
                            {{ csrfField() }}
                            <button type="submit" class="logout">Déconnexion</button>
                        </form>
                    </div>
                </div>
            </nav>
        </header>

        <!-- MAIN GRID -->
        <main class="main">
            <div id="centerContainer">
                <div class="tabs">
                    <ul class="tabs__list">
                        <li>
                            <a href="/timeline" class="tabs__link {{ request.url().startsWith('/timeline') || request.url() === '/' ? 'active' : '' }}">
                                For you
                            </a>
                        </li>
                        <li>
                            <a href="/following" class="tabs__link {{ request.url().startsWith('/following') ? 'active' : '' }}">
                                Following
                            </a>
                        </li> 
                    </ul>
                </div>

                {{-- Messages flash --}}
                <div id="flashContainer"></div>

                <div class="addtwets">
                    <div class="tweet-box">
                        @if(user?.profile_picture)
                            <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">
                        @else
                            <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 20px;">
                                {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                            </div>
                        @endif
                        <div class="tweet-content">
                            <form id="tweetForm" method="POST" action="/tweets" enctype="multipart/form-data">
                                {{ csrfField() }}
                                <textarea name="content" placeholder="What’s happening?" maxlength="280"></textarea>
                                
                                <input type="file" id="mediaInput" name="media" accept="image/*,video/*" style="display:none" />
                                
                                <div id="mediaPreview" style="display:none; margin-top: 10px;">
                                    <img id="previewImg" style="max-width: 100%; border-radius: 16px; display:none;" />
                                    <video id="previewVideo" style="max-width: 100%; border-radius: 16px; display:none;" controls></video>
                                    <button type="button" id="removeMedia" style="margin-top: 5px; background: red; color: white; border: none; padding: 4px 8px; border-radius: 20px; cursor: pointer;">Supprimer</button>
                                </div>
                                
                                <div class="tweet-actions">
                                    <div class="tweet-icons">
                                        <button type="button" class="icon-btn" id="uploadMediaBtn">
                                            <img src="https://www.svgrepo.com/show/535454/image.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="https://www.svgrepo.com/show/520750/gif.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="https://www.svgrepo.com/show/520933/setting.svg" />
                                        </button>
                                        <button type="button" class="icon-btn">
                                            <img src="https://www.svgrepo.com/show/521642/emoji-sad.svg" />
                                        </button>
                                    </div>
                                    <button type="submit" id="tweet-post">Post</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="feedContainer">
                    @if (tweets && tweets.length === 0)
                        <div class="empty-feed">
                            <p>Aucun tweet à afficher. Suivez des utilisateurs pour voir leurs tweets !</p>
                        </div>
                    @else
                        @each(tweet in tweets)
                            <div class="tweet-item" data-tweet-id="{{ tweet.id }}">
                                {{-- SI C'EST UN RETWEET --}}
                                @if (tweet.isRetweet && tweet.originalTweet)
                                    <div class="retweet-header">
                                        <div class="retweet-icon">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                <path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/>
                                            </svg>
                                            <span>{{ tweet.user?.name || tweet.user?.username }} a retweeté</span>
                                        </div>
                                        @if (tweet.userId === user?.id)
                                            <form method="POST" action="/tweets/{{ tweet.id }}/delete" class="delete-form" onsubmit="return confirm('Supprimer ce retweet ?')">
                                                {{ csrfField() }}
                                                <button type="submit" class="delete-btn" title="Supprimer le retweet">
                                                    <img src="https://www.svgrepo.com/show/511788/delete-1487.svg" alt="Supprimer" />
                                                </button>
                                            </form>
                                        @endif
                                    </div>
                                    <div class="tweet-header">
                                        <a href="/profile/{{ tweet.originalTweet.user?.username }}" class="profile-link">
                                            @if(tweet.originalTweet.user?.profile_picture)
                                                <img src="{{ tweet.originalTweet.user.profile_picture }}" class="avatar-img" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">
                                            @else
                                                <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px;">
                                                    {{ tweet.originalTweet.user?.name ? tweet.originalTweet.user.name.charAt(0).toUpperCase() : tweet.originalTweet.user?.username?.charAt(0).toUpperCase() || 'U' }}
                                                </div>
                                            @endif
                                        </a>
                                        <div class="tweet-user-info">
                                            <a href="/profile/{{ tweet.originalTweet.user?.username }}" class="profile-link username-link">
                                                <strong>{{ tweet.originalTweet.user?.name || tweet.originalTweet.user?.username }}</strong>
                                            </a>
                                            <span class="username">{{ tweet.originalTweet.user?.username }}</span>
                                            <span class="time">· {{ tweet.originalTweet.createdAt?.toFormat ? tweet.originalTweet.createdAt.toFormat('dd/MM/yyyy HH:mm') : tweet.originalTweet.createdAt }}</span>
                                        </div>
                                    </div>

                                    <div class="tweet-content">
                                        @if (tweet.originalTweet.content)
                                            <p>{{ tweet.originalTweet.content }}</p>
                                        @endif
                                        @if (tweet.originalTweet.image)
                                            <img src="{{ tweet.originalTweet.image }}" class="tweet-image" />
                                        @endif
                                        @if (tweet.originalTweet.video)
                                            <video src="{{ tweet.originalTweet.video }}" class="tweet-video" controls style="max-width: 100%; border-radius: 16px;"></video>
                                        @endif
                                    </div>

                                    @if (tweet.content)
                                        <div class="retweet-comment">
                                            <div class="retweet-comment-header">
                                                <a href="/profile/{{ user?.username }}" class="profile-link">
                                                    @if(user?.profile_picture)
                                                        <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                                                    @else
                                                        <div class="avatar-circle" style="width: 32px; height: 32px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 14px;">
                                                            {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                                                        </div>
                                                    @endif
                                                </a>
                                                <div>
                                                    <a href="/profile/{{ user?.username }}" class="profile-link">
                                                        <strong>{{ user.name || user.username }}</strong>
                                                    </a>
                                                    <span class="username">{{ user.username }}</span>
                                                </div>
                                            </div>
                                            <p class="retweet-comment-text">{{ tweet.content }}</p>
                                        </div>
                                    @endif
                                    
                                {{--Tweet normal--}}
                                @else
                                    <div class="tweet-header">
                                        <a href="/profile/{{ tweet.user?.username }}" class="profile-link">
                                            @if(tweet.user?.profile_picture)
                                                <img src="{{ tweet.user.profile_picture }}" class="avatar-img" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">
                                            @else
                                                <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px;">
                                                    {{ tweet.user?.name ? tweet.user.name.charAt(0).toUpperCase() : tweet.user?.username?.charAt(0).toUpperCase() || 'U' }}
                                                </div>
                                            @endif
                                        </a>
                                        <div class="tweet-user-info">
                                            <a href="/profile/{{ tweet.user?.username }}" class="profile-link username-link">
                                                <strong>{{ tweet.user?.name || tweet.user?.username }}</strong>
                                            </a>
                                            <span class="username">{{ tweet.user?.username }}</span>
                                            <span class="time">· {{ tweet.createdAt?.toFormat ? tweet.createdAt.toFormat('dd/MM/yyyy HH:mm') : tweet.createdAt }}</span>
                                        </div>

                                        @if (tweet.userId === user?.id)
                                            <div class="tweet-menu">
                                                <button onclick="toggleMenu({{ tweet.id }})">
                                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                                        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z" />
                                                    </svg>
                                                </button>
                                                <div id="menu-{{ tweet.id }}" class="tweet-menu-dropdown hidden">
                                                    <form method="POST" action="/tweets/{{ tweet.id }}/delete" onsubmit="return confirm('Supprimer ce tweet ?')">
                                                        {{ csrfField() }}
                                                        <button type="submit" class="delete-btn" title="Supprimer">
                                                            <img src="https://www.svgrepo.com/show/511788/delete-1487.svg" alt="Supprimer" />
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        @endif
                                    </div>

                                    <div class="tweet-content">
                                        @if (tweet.content)
                                            <p>{{ tweet.content }}</p>
                                        @endif
                                        @if (tweet.image)
                                            <img src="{{ tweet.image }}" class="tweet-image" />
                                        @endif
                                        @if (tweet.video)
                                            <video src="{{ tweet.video }}" class="tweet-video" controls style="max-width: 100%; border-radius: 16px;"></video>
                                        @endif
                                    </div>
                                @endif

                                {{-- BOUTONS D'INTERACTION --}}
                                <div class="tweet-interactions">
                                    <div class="interaction-group">
                                        <form method="POST" action="/tweets/{{ tweet.isRetweet ? tweet.originalTweet.id : tweet.id }}/like" class="like-form">
                                            {{ csrfField() }}
                                            <button type="submit" class="interaction-btn like-btn {{ (tweet.isRetweet ? tweet.originalTweet.$extras?.userLiked : tweet.$extras?.userLiked) ? 'liked' : '' }}">
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                    <path d="M12 21.638h-.014C9.403 21.59 1.95 14.856 1.95 8.478c0-3.064 2.525-5.754 5.403-5.754 2.137 0 3.776 1.478 4.647 2.822.87-1.344 2.51-2.822 4.647-2.822 2.878 0 5.403 2.69 5.403 5.754 0 6.376-7.454 13.11-10.037 13.157H12z"/>
                                                </svg>
                                                <span class="interaction-count">{{ tweet.isRetweet ? (tweet.originalTweet.$extras?.likesCount || 0) : (tweet.$extras?.likesCount || 0) }}</span>
                                            </button>
                                        </form>
                                    </div>
                                    
                                    <div class="interaction-group">
                                        <button class="interaction-btn reply-btn" onclick="openRepliesModal({{ tweet.isRetweet ? tweet.originalTweet.id : tweet.id }}, this)">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                <path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01z"/>
                                            </svg>
                                            <span class="interaction-count">{{ tweet.isRetweet ? (tweet.originalTweet.$extras?.repliesCount || 0) : (tweet.$extras?.repliesCount || 0) }}</span>
                                        </button>
                                    </div>
                                    
                                    <div class="interaction-group">
                                        <button class="interaction-btn retweet-btn" onclick="openRetweetModal({{ tweet.isRetweet ? tweet.originalTweet.id : tweet.id }})">
                                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                                <path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/>
                                            </svg>
                                            <span class="interaction-count">{{ tweet.isRetweet ? (tweet.originalTweet.$extras?.retweetsCount || 0) : (tweet.$extras?.retweetsCount || 0) }}</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        @end
                    @endif
                </div>
            </div>
            
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search"/>
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">
                        Subscribe to unlock new features and if eligible, receive a share of revenue.
                    </p>
                    <button class="btn--secondary">Subscribe</button>
                </div>

                @if (suggestions && suggestions.length > 0)
                    <div id="whoToFollow">
                        <h3>Qui suivre</h3>
                        @each(suggestion in suggestions)
                            <div class="suggestion-item">
                                <a href="/profile/{{ suggestion.username }}" class="suggestion-link">
                                    @if(suggestion.profile_picture)
                                        <img src="{{ suggestion.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                                    @else
                                        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                            {{ suggestion.name ? suggestion.name.charAt(0).toUpperCase() : suggestion.username?.charAt(0).toUpperCase() || 'U' }}
                                        </div>
                                    @endif
                                </a>
                                <div>
                                    <a href="/profile/{{ suggestion.username }}" class="suggestion-link">
                                        <strong>{{ suggestion.name || suggestion.username }}</strong>
                                    </a>
                                    <span>{{ suggestion.username }}</span>
                                </div>
                                <form method="POST" action="/follow/{{ suggestion.id }}">
                                    {{ csrfField() }}
                                    <button type="submit" class="follow-btn">Suivre</button>
                                </form>
                            </div>
                        @end
                    </div>
                @endif
            </div>
        </main>

        {{-- Modale pour poster un tweet --}}
        <div id="tweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('tweetModal')">&times;</button>
                <h3>Nouveau tweet</h3>
                <form id="modalTweetForm" method="POST" action="/tweets">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="What’s happening?" maxlength="280"></textarea>
                    <button type="submit">Poster</button>
                </form>
            </div>
        </div>

        {{-- MODALE POUR LES COMMENTAIRES (REPLIES) --}}
        <div id="repliesModal" class="modal" style="display:none">
            <div class="modal-content modal-replies">
                <button class="close-modal" onclick="closeModal('repliesModal')">&times;</button>
                <h3>Réponses</h3>
                
                {{-- Tweet original --}}
                <div id="originalTweetPreview" class="original-tweet-preview"></div>
                
                {{-- Liste des commentaires --}}
                <div id="repliesList" class="replies-list-modal"></div>
                
                {{-- Formulaire pour commenter --}}
                <div class="reply-form-modal">
                    <div class="reply-input-modal">
                        <a href="/profile/{{ user?.username }}" class="profile-link">
                            @if(user?.profile_picture)
                                <img src="{{ user.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
                            @else
                                <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 16px;">
                                    {{ user?.name ? user.name.charAt(0).toUpperCase() : user?.username?.charAt(0).toUpperCase() || 'U' }}
                                </div>
                            @endif
                        </a>
                        <textarea id="replyContent" placeholder="Écrire une réponse..." maxlength="280"></textarea>
                    </div>
                    <div class="reply-actions-modal">
                        <button class="cancel-reply-modal" onclick="closeModal('repliesModal')">Annuler</button>
                        <button class="submit-reply-modal" id="submitReplyBtn">Répondre</button>
                    </div>
                </div>
            </div>
        </div>

        {{-- Modale pour retweet --}}
        <div id="retweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('retweetModal')">&times;</button>
                <h3>Retweeter</h3>
                <form id="retweetForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Ajouter un commentaire (optionnel)"></textarea>
                    <button type="submit">Retweeter</button>
                </form>
            </div>
        </div>
    @end
@end
<script>
    window.userId = {{ user?.id }};
</script>
@component('layouts/base', { title: `${profileUser.name || profileUser.username} (${profileUser.username})` })
    @slot('main')
        <!-- SIDEBAR GAUCHE -->
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/X_logo_2023.svg/330px-X_logo_2023.svg.png" alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li>
                        <a href="/timeline" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/535437/home.svg" />Home
                        </a>
                    </li>
                    <li>
                        <a href="/search" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/486828/search.svg" />Explore
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512576/notification-bell-1398.svg" />Notifications
                        </a>
                    </li>
                    <li>
                        <a href="/messages" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/522169/mail.svg" />Messages
                        </a>
                    </li>
                    
                    <li>
                        <a href="/communities" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/158210/community.svg" />Communities
                        </a>
                    </li>
                    <li>
                        <a href="/profile/{{ currentUser?.username }}" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512729/profile-round-1342.svg" />Profile
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/521184/more-horizontal.svg" />More
                        </a>
                    </li>
                </ul>

                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
               <div class="user-line" id="userMenu">
    @if(currentUser?.profile_picture)
        <img src="{{ currentUser.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;">
    @else
        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
            {{ currentUser?.name ? currentUser.name.charAt(0).toUpperCase() : currentUser?.username?.charAt(0).toUpperCase() || 'U' }}
        </div>
    @endif
    <div class="user-info">
        <div class="user-name">{{ currentUser?.name || currentUser?.username }}</div>
        <div class="user-handle">{{ currentUser?.username }}</div>
    </div>
    <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
    <div class="popup-menu" hidden>
        <form method="POST" action="/logout">
            {{ csrfField() }}
            <button type="submit" class="logout">Déconnexion</button>
        </form>
    </div>
</div>
            </nav>
        </header>

        <!-- MAIN GRID -->
        <main class="main">
            <div id="centerContainer">
                <div class="followers-header">
                    <div class="back-button">
                        <a href="/profile/{{ profileUser.username }}" class="back-link">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M15 18l-6-6 6-6"/>
                            </svg>
                        </a>
                    </div>
                    <div class="header-info">
                        <h1>Abonnés</h1>
                        <p>{{ profileUser.username }}</p>
                    </div>
                </div>

                <div class="followers-list">
                    @if(followersList && followersList.length > 0)
                        @each(follower in followersList)
                            <div class="follower-item">
                                <a href="/profile/{{ follower.username }}" class="follower-link">
                                    <div class="follower-avatar">
                                        @if(follower.profile_picture)
                                            <img src="{{ follower.profile_picture }}" alt="Avatar">
                                        @else
                                            <div class="avatar-circle" style="width: 50px; height: 50px; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 20px;">
                                                {{ follower.name ? follower.name.charAt(0).toUpperCase() : follower.username.charAt(0).toUpperCase() }}
                                            </div>
                                        @endif
                                    </div>
                                    <div class="follower-info">
                                        <strong>{{ follower.name || follower.username }}</strong>
                                        <span class="username">{{ follower.username }}</span>
                                        <p class="bio">{{ follower.bio ? follower.bio : 'Aucune bio' }}</p>
                                    </div>
                                </a>
                                <div class="follower-action">
                                    @if(currentUser && currentUser.id !== follower.id)
                                        @if(followingIdSet && followingIdSet.has(follower.id))
                                            <form method="POST" action="/follow/{{ follower.id }}">
                                                {{ csrfField() }}
                                                <input type="hidden" name="_method" value="DELETE">
                                                <button type="submit" class="unfollow-btn">Ne plus suivre</button>
                                            </form>
                                        @else
                                            <form method="POST" action="/follow/{{ follower.id }}">
                                                {{ csrfField() }}
                                                <button type="submit" class="follow-btn">Suivre</button>
                                            </form>
                                        @endif
                                    @endif
                                </div>
                            </div>
                        @end
                    @else
                        <div class="empty-feed">
                            <p>Aucun abonné pour le moment.</p>
                        </div>
                    @endif
                </div>
            </div>

            <!-- COLONNE DROITE -->
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search"/>
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">Subscribe to unlock new features and if eligible, receive a share of revenue.</p>
                    <button class="btn--secondary">Subscribe</button>
                </div>

            </div>
        </main>
    @end
@end

<style>
    .followers-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .back-button {
        flex-shrink: 0;
    }
    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        transition: background 0.2s;
    }
    .back-link:hover {
        background: #f3f4f6;
    }
    .header-info h1 {
        font-size: 20px;
        font-weight: 700;
        margin: 0;
        color: black;
    }
    .header-info p {
        color: #6b7280;
        font-size: 13px;
        margin: 2px 0 0;
    }
    .followers-list {
        padding: 0;
    }
    .follower-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-bottom: 1px solid #e5e7eb;
        transition: background 0.2s;
    }
    .follower-item:hover {
        background: #f9f9f9;
    }
    .follower-link {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: inherit;
        flex: 1;
    }
    .follower-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
    }
    .follower-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .follower-info {
        flex: 1;
    }
    .follower-info strong {
        font-size: 16px;
        display: block;
        color: black;
    }
    .follower-info .username {
        color: #6b7280;
        font-size: 14px;
    }
    .follower-info .bio {
        color: #4b5563;
        font-size: 13px;
        margin-top: 4px;
    }
    .follow-btn {
        background: black;
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 9999px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .follow-btn:hover {
        background: #1d9bf0;
    }
    .unfollow-btn {
        background: transparent;
        border: 1px solid #e5e7eb;
        border-radius: 9999px;
        padding: 6px 16px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .unfollow-btn:hover {
        background: #fee2e2;
        border-color: #f4212e;
        color: #f4212e;
    }
    @media (max-width: 768px) {
        .follower-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
        .follower-action {
            align-self: flex-end;
        }
    }
</style>
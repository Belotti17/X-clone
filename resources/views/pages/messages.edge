@component('layouts/base', { title: 'Messages' })
    @slot('main')
        <!-- SIDEBAR GAUCHE -->
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/X_logo_2023.svg/330px-X_logo_2023.svg.png" alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li>
                        <a href="/timeline" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/535437/home.svg" />Home
                        </a>
                    </li>
                    <li>
                        <a href="/search" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/486828/search.svg" />Explore
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512576/notification-bell-1398.svg" />Notifications
                        </a>
                    </li>
                    <li>
                        <a href="/messages" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/522169/mail.svg" />Messages
                        </a>
                    </li>
                    
                    <li>
                        <a href="/communities" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/158210/community.svg" />Communities
                        </a>
                    </li>
                    <li>
                        <a href="/profile/{{ currentUser?.username }}" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/512729/profile-round-1342.svg" />Profile
                        </a>
                    </li>
                    <li>
                        <a href="#" class="nav__link">
                            <img class="nav__icon" src="https://www.svgrepo.com/show/521184/more-horizontal.svg" />More
                        </a>
                    </li>
                </ul>

                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>
               <div class="user-line" id="userMenu">
    @if(currentUser?.profile_picture)
        <img src="{{ currentUser.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;">
    @else
        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
            {{ currentUser?.name ? currentUser.name.charAt(0).toUpperCase() : currentUser?.username?.charAt(0).toUpperCase() || 'U' }}
        </div>
    @endif
    <div class="user-info">
        <div class="user-name">{{ currentUser?.name || currentUser?.username }}</div>
        <div class="user-handle">{{ currentUser?.username }}</div>
    </div>
    <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
    <div class="popup-menu" hidden>
        <form method="POST" action="/logout">
            {{ csrfField() }}
            <button type="submit" class="logout">Déconnexion</button>
        </form>
    </div>
</div>
            </nav>
        </header>

        <main class="main messages-main">
            <div id="centerContainerFull" class="messages-container-full">
                <div class="messages-layout-full">
                    <!-- COLONNE GAUCHE : LISTE DES CONVERSATIONS -->
                    <div class="conversations-sidebar" id="conversationsSidebar">
                        <div class="conversations-header">
                            <h2>Messages</h2>
                            <button class="new-message-btn" id="newMessageBtn">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                    <path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01z"/>
                                </svg>
                            </button>
                        </div>
                        
                        <div class="conversations-list" id="conversationsList">
                            @if(conversations && conversations.length > 0)
                                @each(conv in conversations)
                                    <a href="/messages/{{ conv.user.id }}" class="conversation-item {{ activeConversation?.id === conv.user.id ? 'active' : '' }}" data-user-id="{{ conv.user.id }}">
                                        <div class="conv-avatar">
                                            @if(conv.user.profile_picture)
                                                <img src="{{ conv.user.profile_picture }}" alt="Avatar">
                                            @else
                                                <div class="avatar-circle-small">
                                                    {{ conv.user.name ? conv.user.name.charAt(0).toUpperCase() : conv.user.username.charAt(0).toUpperCase() }}
                                                </div>
                                            @endif
                                            @if(conv.unreadCount > 0)
                                                <span class="unread-badge">{{ conv.unreadCount }}</span>
                                            @endif
                                        </div>
                                        <div class="conv-info">
                                            <div class="conv-name">{{ conv.user.name || conv.user.username }}</div>
                                            <div class="conv-last-message">
                                                {{ conv.lastMessage.content.substring(0, 50) }}{{ conv.lastMessage.content.length > 50 ? '...' : '' }}
                                            </div>
                                            <div class="conv-time">
                                                {{ conv.lastMessage.createdAt?.toFormat ? conv.lastMessage.createdAt.toFormat('dd/MM HH:mm') : '' }}
                                            </div>
                                        </div>
                                    </a>
                                @end
                            @else
                                <div class="empty-conversations" id="emptyConversations">
                                    <p>Aucune conversation</p>
                                    <p class="empty-sub">Envoyez un message a quelqu'un pour commencer</p>
                                    <button class="newMsg-btn new-chat-btn" id="emptyStateNewChatBtn">Nouveau message</button>
                                </div>
                            @endif
                        </div>
                    </div>

                    <!-- COLONNE DROITE : ZONE DE CHAT -->
                    <div class="chat-area" id="chatArea">
                        @if(activeConversation)
                            <div class="chat-header">
                                <button class="mobile-back-btn-header" id="mobileBackHeaderBtn">
                                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                        <path d="M15 18l-6-6 6-6"/>
                                    </svg>
                                </button>
                                <a href="/profile/{{ activeConversation.username }}" class="chat-user-info">
                                    @if(activeConversation.profile_picture)
                                        <img src="{{ activeConversation.profile_picture }}" class="chat-avatar" alt="Avatar">
                                    @else
                                        <div class="avatar-circle-medium">
                                            {{ activeConversation.name ? activeConversation.name.charAt(0).toUpperCase() : activeConversation.username.charAt(0).toUpperCase() }}
                                        </div>
                                    @endif
                                    <div>
                                        <div class="chat-user-name">{{ activeConversation.name || activeConversation.username }}</div>
                                        <div class="chat-user-username">{{ activeConversation.username }}</div>
                                    </div>
                                </a>
                            </div>

                            <div class="messages-list" id="messagesList">
                                @if(messages && messages.length > 0)
                                    @each(message in messages)
                                        <div class="message-item {{ message.senderId === currentUser?.id ? 'message-sent' : 'message-received' }}" data-message-id="{{ message.id }}">
                                            <div class="message-bubble">
                                                <div class="message-content">{{ message.content }}</div>
                                                <div class="message-time">
                                                    {{ message.createdAt.toFormat ? message.createdAt.toFormat('HH:mm') : '' }}
                                                    @if(message.senderId === currentUser?.id && message.isRead)
                                                        <span class="message-read">✓✓</span>
                                                    @elseif(message.senderId === currentUser?.id)
                                                        <span class="message-sent-status">✓</span>
                                                    @endif
                                                </div>
                                            </div>
                                            <!-- Boutons d'action pour les messages envoyés par l'utilisateur -->
                                            @if(message.senderId === currentUser?.id)
                                                <div class="message-actions">
                                                    <button class="message-action-btn edit-message-btn" data-message-id="{{ message.id }}" data-message-content="{{ message.content }}">
                                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                        </svg>
                                                    </button>
                                                    <button class="message-action-btn delete-message-btn" data-message-id="{{ message.id }}">
                                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                        </svg>
                                                    </button>
                                                </div>
                                            @endif
                                        </div>
                                    @end
                                @else
                                    <div class="empty-messages">
                                        <p>Aucun message</p>
                                        <p>Envoyez un premier message a {{ activeConversation.name || activeConversation.username }}</p>
                                    </div>
                                @endif
                            </div>

                            <div class="chat-input-area">
                                <div class="chat-input-wrapper">
                                    <button class="chat-attach-btn" id="attachFileBtn">
                                        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                            <path d="M1.816 15.556v.002c0 1.502.584 2.912 1.646 3.972s2.47 1.647 3.972 1.647l5.56-5.56c.215-.215.215-.564 0-.779l-5.56-5.56c-.215-.215-.564-.215-.779 0l-5.56 5.56c-.215.215-.215.564 0 .779z"/>
                                            <path d="M5.058 2.28l5.56 5.56c.215.215.215.564 0 .779L2.28 16.718c-1.021 1.021-1.021 2.677 0 3.698s2.677 1.021 3.698 0l9.56-9.56c1.021-1.021 1.021-2.677 0-3.698s-2.677-1.021-3.698 0l-9.56 9.56"/>
                                        </svg>
                                    </button>
                                    <textarea id="messageInput" class="chat-input" placeholder="Ecrire un message..." rows="1"></textarea>
                                    <button class="chat-send-btn" id="sendMessageBtn">
                                        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                            <path d="M2.504 21.866l.526-2.108C3.04 19.719 4 15.823 4 12s-.96-7.719-1.47-9.758L2.504.134 20.975 12 2.504 21.866z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        @else
                            <div class="chat-placeholder" id="chatPlaceholder">
                                <svg viewBox="0 0 24 24" width="64" height="64" fill="currentColor">
                                    <path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01z"/>
                                </svg>
                                <h3>Selectionnez une conversation</h3>
                                <p>Choisissez une conversation existante ou commencez-en une nouvelle</p>
                                <button class="newMsg-btn" id="startNewChatBtn">Nouveau message</button>
                            </div>
                        @endif
                    </div>
                </div>
            </div>
        </main>

        <!-- MODALE MODIFIER MESSAGE -->
        <div id="editMessageModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('editMessageModal')">&times;</button>
                <h3>Modifier le message</h3>
                <form id="editMessageForm">
                    <textarea id="editMessageContent" placeholder="Modifier votre message..." rows="3" style="width:100%; padding:12px; border:1px solid #e5e7eb; border-radius:12px; font-family:inherit; resize:none;"></textarea>
                    <div style="display:flex; gap:12px; margin-top:16px;">
                        <button type="button" class="cancel-edit-btn" onclick="closeModal('editMessageModal')" style="flex:1; padding:10px; border-radius:9999px; border:1px solid #e5e7eb; background:white; cursor:pointer;">Annuler</button>
                        <button type="submit" class="save-edit-btn" style="flex:1; padding:10px; border-radius:9999px; background:black; color:white; border:none; cursor:pointer;">Enregistrer</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- MODALE NOUVEAU MESSAGE -->
        <div id="newMessageModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('newMessageModal')">&times;</button>
                <h3>Nouveau message</h3>
                <div class="search-users">
                    <input type="text" id="searchUsersInput" placeholder="Rechercher un utilisateur..." autocomplete="off">
                    <div id="searchUsersResults" class="search-users-results"></div>
                </div>
            </div>
        </div>
    @end
@end

<style>
/* ========== STYLES MESSAGES PLEINE LARGEUR ========== */

.messages-container-full {
    width: 100%;
    max-width: 100%;
    margin: 0;
    height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
}

.messages-layout-full {
    display: flex;
    height: 100%;
    background: white;
    overflow: hidden;
}

/* ========== COLONNE GAUCHE ========== */
.conversations-sidebar {
    width: 380px;
    border-right: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    background: #fafafa;
    transition: transform 0.3s ease;
}

.conversations-header {
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    border-left: 1px solid #e5e7eb;
}

.conversations-header h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0;
}

.new-message-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 9999px;
    color: #1d9bf0;
    transition: background 0.2s;
}

.new-message-btn:hover {
    background: rgba(29, 155, 240, 0.1);
}

.mobile-back-btn-header {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 9999px;
    color: #1d9bf0;
    align-items: center;
    justify-content: center;
}

.mobile-back-btn-header:hover {
    background: rgba(29, 155, 240, 0.1);
}

.conversations-list {
    flex: 1;
    overflow-y: auto;
    border-left: 1px solid #e5e7eb;
}

.conversation-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    text-decoration: none;
    transition: background 0.2s;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
}

.conversation-item:hover {
    background: #f3f4f6;
}

.conversation-item.active {
    background: rgba(29, 155, 240, 0.1);
}

.conv-avatar {
    position: relative;
    flex-shrink: 0;
}

.conv-avatar img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
}

.avatar-circle-small {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #1d9bf0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 18px;
}

.unread-badge {
    position: absolute;
    bottom: 0;
    right: 0;
    background: #1d9bf0;
    color: white;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 9999px;
    border: 2px solid white;
}

.conv-info {
    flex: 1;
    min-width: 0;
}

.conv-name {
    font-weight: 600;
    color: black;
    margin-bottom: 4px;
}

.conv-last-message {
    font-size: 13px;
    color: #6b7280;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.conv-time {
    font-size: 11px;
    color: #9ca3af;
    margin-top: 2px;
}

/* ========== ZONE DE CHAT ========== */
.chat-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: white;
}

.chat-header {
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    gap: 12px;
}

.chat-user-info {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
}

.chat-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
}

.avatar-circle-medium {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #1d9bf0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 20px;
}

.chat-user-name {
    font-weight: 600;
    color: black;
}

.chat-user-username {
    font-size: 13px;
    color: #6b7280;
}

/* Liste des messages */
.messages-list {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.message-item {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    width: 100%;
    position: relative;
}

.message-sent {
    justify-content: flex-end;
}

.message-received {
    justify-content: flex-start;
}

.message-bubble {
    max-width: 65%;
    padding: 10px 14px;
    border-radius: 20px;
    position: relative;
}

.message-sent .message-bubble {
    background: #1d9bf0;
    color: white;
    border-bottom-right-radius: 4px;
}

.message-received .message-bubble {
    background: #9ca3af;
    color: black;
    border-bottom-left-radius: 4px;
}

.message-content {
    font-size: 14px;
    word-wrap: break-word;
}

.message-time {
    font-size: 10px;
    margin-top: 4px;
    opacity: 0.7;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
}

.message-read {
    color: #ffffff;
}

/* Boutons d'action sur les messages */
.message-actions {
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s ease;
}

.message-item:hover .message-actions {
    opacity: 1;
}

.message-action-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: 9999px;
    color: #6b7280;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
}

.message-action-btn:hover {
    background: rgba(29, 155, 240, 0.1);
    color: #1d9bf0;
}

.delete-message-btn:hover {
    color: #f4212e;
}

.delete-message-btn:hover {
    background: rgba(244, 33, 46, 0.1);
}

.newMsg-btn{
    background: black;
    color: #fff;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 20px;
    border: none;
}

/* Zone de saisie */
.chat-input-area {
    padding: 16px;
    border-top: 1px solid #e5e7eb;
    background: white;
}

.chat-input-wrapper {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    background: #f3f4f6;
    border-radius: 9999px;
    padding: 8px 16px;
}

.chat-attach-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #1d9bf0;
    padding: 4px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
}

.chat-attach-btn:hover {
    background: rgba(29, 155, 240, 0.1);
}

.chat-input {
    flex: 1;
    background: transparent;
    border: none;
    resize: none;
    font-size: 14px;
    font-family: inherit;
    max-height: 100px;
    padding: 4px 0;
}

.chat-input:focus {
    outline: none;
}

.chat-send-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #1d9bf0;
    padding: 4px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
}

.chat-send-btn:hover {
    background: rgba(29, 155, 240, 0.1);
}

/* Placeholder */
.chat-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #6b7280;
    gap: 16px;
}

.chat-placeholder svg {
    color: #d1d5db;
}

.chat-placeholder h3 {
    font-size: 20px;
    font-weight: 700;
    color: black;
    margin: 0;
}

.chat-placeholder p {
    font-size: 14px;
}

/* Etats vides */
.empty-conversations {
    text-align: center;
    padding: 48px 24px;
    color: #6b7280;
}

.empty-conversations .empty-sub {
    font-size: 13px;
    margin-top: 8px;
    margin-bottom: 20px;
}

.new-chat-btn {
    margin-top: 16px;
}

.empty-messages {
    text-align: center;
    padding: 48px;
    color: #6b7280;
}

/* Modale recherche utilisateurs */
.search-users {
    margin-top: 16px;
}

#searchUsersInput {
    width: 100%;
    padding: 12px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 14px;
}

#searchUsersInput:focus {
    outline: none;
    border-color: #1d9bf0;
}

.search-users-results {
    margin-top: 16px;
    max-height: 300px;
    overflow-y: auto;
}

.search-user-result {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    border-bottom: 1px solid #e5e7eb;
    cursor: pointer;
    transition: background 0.2s;
}

.search-user-result:hover {
    background: #f3f4f6;
}

.search-user-result .user-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.start-chat-btn {
    background: #1d9bf0;
    color: white;
    border: none;
    padding: 6px 16px;
    border-radius: 9999px;
    cursor: pointer;
    font-size: 13px;
}

.start-chat-btn:hover {
    background: #1a8cd8;
}

/* ========== MEDIA QUERIES RESPONSIVE ========== */

/* Tablettes (768px - 1024px) */
@media (max-width: 1024px) {
    .conversations-sidebar {
        width: 320px;
    }
    
    .message-bubble {
        max-width: 75%;
    }
}

/* Mobiles (moins de 768px) */
@media (max-width: 768px) {
    .messages-layout-full {
        position: relative;
    }
    
    .conversations-sidebar {
        position: relative;
        left: 0;
        top: 0;
        width: 100%;
        max-width: 100%;
        height: 100%;
        z-index: 10;
        transform: translateX(0);
        box-shadow: none;
    }
    
    .messages-layout-full.has-active-conversation .conversations-sidebar {
        display: none;
    }
    
    .messages-layout-full.has-active-conversation .chat-area {
        display: flex;
        width: 100%;
    }
    
    .chat-area {
        display: none;
    }
    
    .messages-layout-full.has-active-conversation .chat-area {
        display: flex;
    }
    
    /* Afficher le bouton retour dans l'en-tete du chat */
    .mobile-back-btn-header {
        display: flex;
    }
    
    .chat-header {
        padding: 12px;
        border-left: 1px solid #e5e7eb;
    }
    
    .chat-user-info {
        flex: 1;
    }
    
    .chat-avatar, .avatar-circle-medium {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .chat-user-name {
        font-size: 15px;
    }
    
    .chat-user-username {
        font-size: 12px;
    }
    
    .messages-list {
        padding: 12px;
        border-left: 1px solid #e5e7eb;
    }
    
    .message-bubble {
        max-width: 85%;
        padding: 8px 12px;
    }
    
    .message-content {
        font-size: 13px;
    }
    
    .chat-input-area {
        padding: 12px;
    }
    
    .chat-input-wrapper {
        padding: 6px 12px;
    }
    
    .chat-attach-btn, .chat-send-btn {
        padding: 4px;
    }
    
    .chat-attach-btn svg, .chat-send-btn svg {
        width: 20px;
        height: 20px;
    }
    
    .chat-input {
        font-size: 13px;
    }
    
    .conv-avatar img, .avatar-circle-small {
        width: 44px;
        height: 44px;
        font-size: 16px;
    }
    
    .conv-name {
        font-size: 14px;
    }
    
    .conv-last-message {
        font-size: 12px;
    }
    
    .empty-messages, .empty-conversations {
        padding: 32px 20px;
    }
    
    .chat-placeholder h3 {
        font-size: 18px;
    }
    
    .chat-placeholder p {
        font-size: 14px;
    }
    
    .chat-placeholder svg {
        width: 48px;
        height: 48px;
    }
}

/* Tres petits mobiles (moins de 425px) - CACHER LE PLACEHOLDER */
@media (max-width: 425px) {
    .chat-placeholder {
        display: none !important;
    }
    
    .conversations-sidebar {
        width: 100%;
        max-width: 100%;
    }
    
    .conversations-header h2 {
        font-size: 18px;
    }
    
    .chat-user-name {
        font-size: 14px;
    }
    
    .message-bubble {
        max-width: 90%;
    }
    
    .message-content {
        font-size: 12px;
    }
    
    .conv-avatar img, .avatar-circle-small {
        width: 40px;
        height: 40px;
        font-size: 14px;
    }
    
    .conv-info {
        max-width: calc(100% - 52px);
    }
    
    .conv-last-message {
        font-size: 11px;
    }
    
    .conv-time {
        font-size: 10px;
    }
}

/* Modales */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-content {
    background: white;
    border-radius: 20px;
    padding: 24px;
    width: 90%;
    max-width: 500px;
    position: relative;
}

.close-modal {
    position: absolute;
    top: 16px;
    right: 16px;
    background: transparent;
    border: none;
    font-size: 24px;
    cursor: pointer;
}

@media (max-width: 480px) {
    .modal-content {
        padding: 20px;
        width: 95%;
    }
    
    .modal-content h3 {
        font-size: 18px;
    }
}

.cancel-edit-btn:hover {
    background: #f3f4f6;
}

.save-edit-btn:hover {
    background: #1d9bf0;
}
</style>

<script>
    let currentUserId = {{ currentUser?.id }};
    let currentConversationId = {{ activeConversation?.id || 'null' }};
    let lastMessageId = 0;
    let pollingInterval = null;
    let isSending = false;
    let currentEditMessageId = null;

    document.addEventListener('DOMContentLoaded', function() {
        const messageInput = document.getElementById('messageInput');
        if (messageInput) {
            messageInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 100) + 'px';
            });
        }

        const sendBtn = document.getElementById('sendMessageBtn');
        if (sendBtn) {
            sendBtn.addEventListener('click', sendMessage);
        }
        if (messageInput) {
            messageInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });
        }

        const newMessageBtn = document.getElementById('newMessageBtn');
        const startNewChatBtn = document.getElementById('startNewChatBtn');
        const emptyStateNewChatBtn = document.getElementById('emptyStateNewChatBtn');
        
        if (newMessageBtn) {
            newMessageBtn.addEventListener('click', () => openModal('newMessageModal'));
        }
        if (startNewChatBtn) {
            startNewChatBtn.addEventListener('click', () => openModal('newMessageModal'));
        }
        if (emptyStateNewChatBtn) {
            emptyStateNewChatBtn.addEventListener('click', () => openModal('newMessageModal'));
        }

        const searchInput = document.getElementById('searchUsersInput');
        if (searchInput) {
            searchInput.addEventListener('input', debounce(searchUsers, 300));
        }

        const mobileBackHeaderBtn = document.getElementById('mobileBackHeaderBtn');
        const messagesLayout = document.querySelector('.messages-layout-full');
        
        if (mobileBackHeaderBtn) {
            mobileBackHeaderBtn.addEventListener('click', function() {
                messagesLayout.classList.remove('has-active-conversation');
                if (window.history && window.history.pushState) {
                    window.history.pushState({}, '', '/messages');
                }
            });
        }

        if (window.innerWidth <= 768) {
            if (currentConversationId) {
                messagesLayout.classList.add('has-active-conversation');
            }
        }

        document.querySelectorAll('.conversation-item').forEach(item => {
            item.addEventListener('click', function(e) {
                if (window.innerWidth <= 768) {
                    setTimeout(() => {
                        messagesLayout.classList.add('has-active-conversation');
                    }, 150);
                }
            });
        });

        // Gestion des boutons modifier et supprimer
        setupMessageActionButtons();

        if (currentConversationId) {
            startPolling();
            scrollToBottom();
        }
    });

    // Configuration des boutons d'action sur les messages
    function setupMessageActionButtons() {
        // Boutons modifier
        document.querySelectorAll('.edit-message-btn').forEach(btn => {
            btn.removeEventListener('click', handleEditClick);
            btn.addEventListener('click', handleEditClick);
        });

        // Boutons supprimer
        document.querySelectorAll('.delete-message-btn').forEach(btn => {
            btn.removeEventListener('click', handleDeleteClick);
            btn.addEventListener('click', handleDeleteClick);
        });
    }

    // Gestion du clic sur modifier
    function handleEditClick(e) {
        e.stopPropagation();
        const messageId = this.dataset.messageId;
        const messageContent = this.dataset.messageContent;
        currentEditMessageId = messageId;
        const textarea = document.getElementById('editMessageContent');
        if (textarea) {
            textarea.value = messageContent;
        }
        openModal('editMessageModal');
    }

    // Gestion du clic sur supprimer
    async function handleDeleteClick(e) {
        e.stopPropagation();
        const messageId = this.dataset.messageId;
        if (confirm('Supprimer ce message ?')) {
            try {
                const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
                const response = await fetch(`/messages/${messageId}`, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRF-TOKEN': csrfToken || '',
                        'Content-Type': 'application/json'
                    }
                });
                if (response.ok) {
                    const messageElement = document.querySelector(`.message-item[data-message-id="${messageId}"]`);
                    if (messageElement) {
                        messageElement.remove();
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Erreur lors de la suppression');
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Erreur lors de la suppression');
            }
        }
    }

    // Formulaire de modification
    const editForm = document.getElementById('editMessageForm');
    if (editForm) {
        editForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const newContent = document.getElementById('editMessageContent').value.trim();
            if (!newContent) {
                alert('Le message ne peut pas être vide');
                return;
            }
            try {
                const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
                const response = await fetch(`/messages/${currentEditMessageId}`, {
                    method: 'PUT',
                    headers: {
                        'X-CSRF-TOKEN': csrfToken || '',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ content: newContent })
                });
                if (response.ok) {
                    const data = await response.json();
                    const messageElement = document.querySelector(`.message-item[data-message-id="${currentEditMessageId}"]`);
                    if (messageElement) {
                        const contentDiv = messageElement.querySelector('.message-content');
                        if (contentDiv) {
                            contentDiv.textContent = newContent;
                        }
                        const editBtn = messageElement.querySelector('.edit-message-btn');
                        if (editBtn) {
                            editBtn.dataset.messageContent = newContent;
                        }
                    }
                    closeModal('editMessageModal');
                } else {
                    const data = await response.json();
                    alert(data.error || 'Erreur lors de la modification');
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Erreur lors de la modification');
            }
        });
    }

    async function sendMessage() {
        if (isSending) return;
        
        const input = document.getElementById('messageInput');
        const content = input.value.trim();
        
        if (!content || !currentConversationId) return;
        
        isSending = true;
        
        try {
            const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
            const response = await fetch('/messages', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': csrfToken || ''
                },
                body: JSON.stringify({
                    receiver_id: currentConversationId,
                    content: content
                })
            });
            
            if (response.ok) {
                const result = await response.json();
                input.value = '';
                input.style.height = 'auto';
                appendMessageToChat(result.message, true);
                scrollToBottom();
            }
        } catch (error) {
            console.error('Erreur:', error);
        } finally {
            isSending = false;
        }
    }

    function appendMessageToChat(message, isOwnMessage) {
        const messagesList = document.getElementById('messagesList');
        if (!messagesList) return;
        
        const emptyMessages = messagesList.querySelector('.empty-messages');
        if (emptyMessages) emptyMessages.remove();
        
        const messageDiv = document.createElement('div');
        messageDiv.className = `message-item ${isOwnMessage ? 'message-sent' : 'message-received'}`;
        messageDiv.setAttribute('data-message-id', message.id);
        
        const time = new Date(message.createdAt);
        const timeStr = time.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
        
        let actionsHtml = '';
        if (isOwnMessage) {
            actionsHtml = `
                <div class="message-actions">
                    <button class="message-action-btn edit-message-btn" data-message-id="${message.id}" data-message-content="${escapeHtml(message.content)}">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                        </svg>
                    </button>
                    <button class="message-action-btn delete-message-btn" data-message-id="${message.id}">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </svg>
                    </button>
                </div>
            `;
        }
        
        messageDiv.innerHTML = `
            <div class="message-bubble">
                <div class="message-content">${escapeHtml(message.content)}</div>
                <div class="message-time">
                    ${timeStr}
                    ${isOwnMessage ? '<span class="message-sent-status">✓</span>' : ''}
                </div>
            </div>
            ${actionsHtml}
        `;
        
        messagesList.appendChild(messageDiv);
        
        if (isOwnMessage) {
            const newEditBtn = messageDiv.querySelector('.edit-message-btn');
            const newDeleteBtn = messageDiv.querySelector('.delete-message-btn');
            if (newEditBtn) {
                newEditBtn.addEventListener('click', handleEditClick);
            }
            if (newDeleteBtn) {
                newDeleteBtn.addEventListener('click', handleDeleteClick);
            }
        }
    }

    function startPolling() {
        if (pollingInterval) clearInterval(pollingInterval);
        
        pollingInterval = setInterval(async () => {
            if (!currentConversationId) return;
            
            try {
                const response = await fetch(`/messages/new?conversation_id=${currentConversationId}&last_message_id=${lastMessageId}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.messages && data.messages.length > 0) {
                        for (const message of data.messages) {
                            if (message.senderId !== currentUserId) {
                                appendMessageToChat(message, false);
                            }
                            if (message.id > lastMessageId) {
                                lastMessageId = message.id;
                            }
                        }
                        scrollToBottom();
                    }
                }
            } catch (error) {
                console.error('Polling error:', error);
            }
        }, 2000);
    }

    async function searchUsers() {
        const query = document.getElementById('searchUsersInput')?.value.trim();
        const resultsDiv = document.getElementById('searchUsersResults');
        
        if (!query || query.length < 2) {
            if (resultsDiv) resultsDiv.innerHTML = '';
            return;
        }
        
        try {
            const response = await fetch(`/search?q=${encodeURIComponent(query)}&tab=users`);
            if (response.ok) {
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const users = doc.querySelectorAll('.search-user-item');
                
                resultsDiv.innerHTML = '';
                
                users.forEach(user => {
                    const username = user.querySelector('.search-user-info strong')?.textContent;
                    const handle = user.querySelector('.username')?.textContent;
                    const avatar = user.querySelector('.search-user-avatar img')?.outerHTML || 
                                  user.querySelector('.avatar-circle-small')?.outerHTML;
                    const userId = user.querySelector('.follow-form-search')?.dataset.userId;
                    
                    if (userId && userId != currentUserId) {
                        const resultDiv = document.createElement('div');
                        resultDiv.className = 'search-user-result';
                        resultDiv.innerHTML = `
                            <div class="user-info">
                                ${avatar || '<div class="avatar-circle-small">U</div>'}
                                <div>
                                    <strong>${escapeHtml(username || '')}</strong>
                                    <div class="username">${escapeHtml(handle || '')}</div>
                                </div>
                            </div>
                            <button class="start-chat-btn" data-user-id="${userId}" data-username="${escapeHtml(handle || '')}">Message</button>
                        `;
                        resultsDiv.appendChild(resultDiv);
                    }
                });
                
                document.querySelectorAll('.start-chat-btn').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        e.stopPropagation();
                        const userId = btn.dataset.userId;
                        window.location.href = `/messages/${userId}`;
                    });
                });
            }
        } catch (error) {
            console.error('Search error:', error);
        }
    }

    function scrollToBottom() {
        const messagesList = document.getElementById('messagesList');
        if (messagesList) {
            messagesList.scrollTop = messagesList.scrollHeight;
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    function openModal(modalId) {
        document.getElementById(modalId).style.display = 'flex';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    window.addEventListener('beforeunload', () => {
        if (pollingInterval) clearInterval(pollingInterval);
    });

    const menuBtn = document.querySelector('.user-menu');
    const popupMenu = document.querySelector('.popup-menu');
    if (menuBtn && popupMenu) {
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            popupMenu.classList.toggle('hidden');
        });
        document.addEventListener('click', () => popupMenu.classList.add('hidden'));
    }
</script>
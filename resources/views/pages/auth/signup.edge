@component('layouts/main', { title: 'S\'inscrire sur X' })
  @slot('assets')
    @vite(['resources/css/signup.css', 'resources/js/signup.js'])
  @end

  @slot('main')
    <main class="login-container">
      <div class="content">
        <div class="logo">
          <img src="https://mail.google.com/mail/u/0?ui=2&ik=a85cfa118b&attid=0.1&permmsgid=msg-a:r-4042161132938590700&th=19d3b4f931037916&view=fimg&fur=ip&permmsgid=msg-a:r-4042161132938590700&sz=s0-l75-ft&attbid=ANGjdJ-oQSRNXAvgSxSLgJHUmsD0EUzUYXUXsEkN1eN0fnRps2iop-4uVdIAxQBuVpvdRHmJaHLSEI_4uCYJ4n0TxMBmZ0Cke5L8WVlOb7aZEKeTJ2bUfcwboLtcgMA&disp=emb&realattid=ii_mnc7ybur0&zw" alt="Logo X" />
        </div>
        <div class="compte">
          <h1 class="title">Ça se passe <br />maintenant</h1>
          <h2>Inscrivez-vous.</h2>

          <button class="btn-login" type="button">
            <img src="data:image/jpeg;base64," />
            S'inscrire avec Google
          </button>

          <button class="btn-icon" type="button">
            <img src="data:image/jpeg;base64," />
            S'inscrire avec Apple
          </button>

          <span class="ou-separat">OU</span>

          <button class="creat" type="button" onclick="openSignup()">
            Créer un compte
          </button>

          <div class="overlay" id="overlay">
            <aside class="modal">
              <button class="close" type="button" onclick="closeSignup()">✕</button>
              <div class="modal-logo">
                <img src="https://mail.google.com/mail/u/0?ui=2&ik=a85cfa118b&attid=0.1&permmsgid=msg-a:r-4042161132938590700&th=19d3b4f931037916&view=fimg&fur=ip&permmsgid=msg-a:r-4042161132938590700&sz=s0-l75-ft&attbid=ANGjdJ-oQSRNXAvgSxSLgJHUmsD0EUzUYXUXsEkN1eN0fnRps2iop-4uVdIAxQBuVpvdRHmJaHLSEI_4uCYJ4n0TxMBmZ0Cke5L8WVlOb7aZEKeTJ2bUfcwboLtcgMA&disp=emb&realattid=ii_mnc7ybur0&zw" />
              </div>

              @form({ route: 'new_account.store', method: 'POST', class:'modal-body' })
                @if (flashMessages.has('errors'))
                  <div style="color:red; margin-bottom:10px;">
                    @each(error in flashMessages.get('errors'))
                      <p>{{ error.message }}</p>
                    @end
                  </div>
                @endif

                <div class="modal-header">
                  <h1>Créer votre compte</h1>
                </div>

                <div class="field">
                  <input name="name" placeholder="Nom et prénom" required />
                </div>

                <div class="field">
                  <input name="username" placeholder="Nom d'utilisateur" required />
                </div>

                <div class="field">
                  <input type="email" name="email" placeholder="Email" required />
                </div>

                <div class="field">
                  <input type="password" name="password" placeholder="Mot de passe" required />
                </div>

                <div class="field">
                  <input type="password" name="passwordConfirmation" placeholder="Confirmer" required />
                </div>

                <div class="actions">
                  <button class="primary" type="submit">Suivant</button>
                </div>
              @end
            </aside>
          </div>

          <p class="cookies">
            En vous inscrivant, vous acceptez les <a href="#">Conditions d'utilisation</a>.
          </p>

          <div class="connecter">
            <span>Vous avez déjà un compte ?</span>
            <button type="button" onclick="openLogin()">Se connecter</button>
          </div>
        </div>
      </div>

      <div id="popup-x" class="overlay-x @if(flashMessages.has('loginError')) active @end">
        <div class="popup-content-x">
          <button class="close-x" type="button" onclick="closeLogin()">X</button>
          <div class="logo-x"><img src="https://mail.google.com/mail/u/0?ui=2&ik=a85cfa118b&attid=0.1&permmsgid=msg-a:r-4042161132938590700&th=19d3b4f931037916&view=fimg&fur=ip&permmsgid=msg-a:r-4042161132938590700&sz=s0-l75-ft&attbid=ANGjdJ-oQSRNXAvgSxSLgJHUmsD0EUzUYXUXsEkN1eN0fnRps2iop-4uVdIAxQBuVpvdRHmJaHLSEI_4uCYJ4n0TxMBmZ0Cke5L8WVlOb7aZEKeTJ2bUfcwboLtcgMA&disp=emb&realattid=ii_mnc7ybur0&zw" /></div>
          <h2 class="title-x">Connectez-vous à X</h2>
          @if (flashMessages.has('loginError'))
            <p role="alert" style="color: #ff4444;">{{ flashMessages.get('loginError') }}</p>
          @endif
          @form({ route: 'session.store', method: 'POST' })
            <input class="input-x" type="email" name="email" placeholder="Email" required />
            <input class="input-x" type="password" name="password" placeholder="Mot de passe" required />
            <button class="btn-black-x" type="submit">Se connecter</button>
          @end
        </div>
      </div>

      <footer>
        <div class="footer-container">
          <span>
            À propos | Téléchargez l'application X | Grok | Centre d'assistance |
            Conditions d'utilisation | Politique de Confidentialité | © 2026 X Corp.
          </span>
        </div>
      </footer>
    </main>

    <script>
      function openSignup(){ document.getElementById("overlay").style.display = "flex" }
      function closeSignup(){ document.getElementById("overlay").style.display = "none" }
      function openLogin(){ document.getElementById("popup-x").classList.add("active") }
      function closeLogin(){ document.getElementById("popup-x").classList.remove("active") }
    </script>
  @end
@end
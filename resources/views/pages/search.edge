@component('layouts/base', { title: query ? `Recherche : ${query}` : 'Recherche' })
    @slot('main')
        <header>
            <div class="nav__logo">
                <a href="/timeline"><img src="data:image/jpeg;base64," alt="logo X" /></a>
            </div>

            <nav class="nav">
                <ul class="nav__list">
                    <li><a href="/timeline" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/535437/home.svg" />Home</a></li>
                    <li><a href="/search" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/486828/search.svg" />Explore</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/512576/notification-bell-1398.svg" />Notifications</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/522169/mail.svg" />Messages</a></li>
                    <li><a href="/communities" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/158210/community.svg" />Communities</a></li>
                    <li><a href="/profile/{{ currentUser?.username }}" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/512729/profile-round-1342.svg" />Profile</a></li>
                    <li><a href="#" class="nav__link"><img class="nav__icon" src="https://www.svgrepo.com/show/521184/more-horizontal.svg" />More</a></li>
                </ul>

                <div style="margin-top: 20px">
                    <button class="btn--primary" id="openTweetModal">Post</button>
                </div>

                <div class="user-line" id="userMenu">
                    @if(currentUser?.profile_picture)
                        <img src="{{ currentUser.profile_picture }}" class="avatar-img" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px;">
                    @else
                        <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px; margin-right: 12px;">
                            {{ currentUser?.name ? currentUser.name.charAt(0).toUpperCase() : currentUser?.username?.charAt(0).toUpperCase() || 'U' }}
                        </div>
                    @endif
                    <div class="user-info">
                        <div class="user-name">{{ currentUser?.name || currentUser?.username }}</div>
                        <div class="user-handle">{{ currentUser?.username }}</div>
                    </div>
                    <button class="user-menu" aria-label="Menu utilisateur">⋯</button>
                    <div class="popup-menu" hidden>
                        <form method="POST" action="/logout">
                            {{ csrfField() }}
                            <button type="submit" class="logout">Déconnexion</button>
                        </form>
                    </div>
                </div>
            </nav>
        </header>

        <main class="main">
            <div id="centerContainer">
                <!-- HEADER RECHERCHE -->
                <div class="search-header">
                    <div class="search-input-wrapper">
                        <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <form action="/search" method="GET" class="search-form">
                            <input type="text" name="q" class="search-input" placeholder="Rechercher des utilisateurs, des posts, des hashtags..." value="{{ query }}" autocomplete="off">
                        </form>
                        @if(query)
                            <a href="/search" class="search-clear">×</a>
                        @endif
                    </div>
                </div>

                @if(searchPerformed)
                    <!-- ONGLETS -->
                    <div class="search-tabs">
                        <a href="/search?q={{ encodeURIComponent(query) }}&tab=top" class="search-tab {{ activeTab === 'top' ? 'active' : '' }}">Top</a>
                        <a href="/search?q={{ encodeURIComponent(query) }}&tab=posts" class="search-tab {{ activeTab === 'posts' ? 'active' : '' }}">Posts</a>
                        <a href="/search?q={{ encodeURIComponent(query) }}&tab=users" class="search-tab {{ activeTab === 'users' ? 'active' : '' }}">Utilisateurs</a>
                        <a href="/search?q={{ encodeURIComponent(query) }}&tab=hashtags" class="search-tab {{ activeTab === 'hashtags' ? 'active' : '' }}">Hashtags</a>
                    </div>

                    <!-- RÉSULTATS - UTILISATEURS -->
                    @if((activeTab === 'top' || activeTab === 'users') && users.length > 0)
                        <div class="search-results-section">
                            <h3 class="search-section-title">Utilisateurs</h3>
                            @each(user in users)
                                <div class="search-user-item">
                                    <a href="/profile/{{ user.username }}" class="search-user-link">
                                        <div class="search-user-avatar">
                                            @if(user.profile_picture)
                                                <img src="{{ user.profile_picture }}" alt="Avatar">
                                            @else
                                                <div class="avatar-circle-small">
                                                    {{ user.name ? user.name.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase() }}
                                                </div>
                                            @endif
                                        </div>
                                        <div class="search-user-info">
                                            <strong>{{ user.name || user.username }}</strong>
                                            <span class="username">{{ user.username }}</span>
                                            @if(user.bio)
                                                <p class="user-bio">{{ user.bio.substring(0, 100) }}{{ user.bio.length > 100 ? '...' : '' }}</p>
                                            @endif
                                        </div>
                                    </a>
                                    <div class="search-user-action">
                                        @if(!user.isCurrentUser)
                                            <form class="follow-form-search" data-user-id="{{ user.id }}" data-following="{{ user.isFollowing ? 'true' : 'false' }}">
                                                {{ csrfField() }}
                                                <button type="button" class="follow-btn-search {{ user.isFollowing ? 'following' : '' }}">
                                                    {{ user.isFollowing ? 'Abonné' : 'Suivre' }}
                                                </button>
                                            </form>
                                        @endif
                                    </div>
                                </div>
                            @end
                        </div>
                    @endif

                    <!-- RÉSULTATS - TWEETS -->
                    @if((activeTab === 'top' || activeTab === 'posts') && tweets.length > 0)
                        <div class="search-results-section">
                            <h3 class="search-section-title">Posts</h3>
                            @each(tweet in tweets)
                                <div class="search-tweet-item">
                                    <div class="tweet-header">
                                        @if(tweet.user?.profile_picture)
                                            <img src="{{ tweet.user.profile_picture }}" class="avatar-img" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;">
                                        @else
                                            <div class="avatar-circle" style="width: 48px; height: 48px; border-radius: 50%; background: #1d9bf0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 18px;">
                                                {{ tweet.user?.name ? tweet.user.name.charAt(0).toUpperCase() : tweet.user?.username?.charAt(0).toUpperCase() || 'U' }}
                                            </div>
                                        @endif
                                        <div class="tweet-user-info">
                                            <div class="tweet-user-name">
                                                <strong>{{ tweet.user?.name || tweet.user?.username }}</strong>
                                                <span class="username">{{ tweet.user?.username }}</span>
                                                <span class="time">· {{ tweet.createdAt?.toFormat ? tweet.createdAt.toFormat('dd/MM/yyyy HH:mm') : tweet.createdAt }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tweet-content">
                                        <a href="/tweets/{{ tweet.id }}">
                                            <p>{{ tweet.content }}</p>
                                        </a>
                                        @if(tweet.image)
                                            <img src="{{ tweet.image }}" class="tweet-image" />
                                        @endif
                                        @if(tweet.video)
                                            <video src="{{ tweet.video }}" class="tweet-video" controls></video>
                                        @endif
                                    </div>
                                    <div class="tweet-interactions">
                                        <div class="interaction-group">
                                            <button onclick="openReplyModal({{ tweet.id }}, this)" class="interaction-btn reply-btn">
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01z"/></svg>
                                                <span>{{ tweet.$extras?.repliesCount || 0 }}</span>
                                            </button>
                                        </div>
                                        <div class="interaction-group">
                                            <button onclick="openRetweetModal({{ tweet.id }})" class="interaction-btn retweet-btn">
                                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg>
                                                <span>{{ tweet.$extras?.retweetsCount || 0 }}</span>
                                            </button>
                                        </div>
                                        <div class="interaction-group">
                                            <form method="POST" action="/tweets/{{ tweet.id }}/like" class="like-form">
                                                {{ csrfField() }}
                                                <button type="submit" class="interaction-btn like-btn {{ tweet.$extras?.userLiked ? 'liked' : '' }}">
                                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 21.638h-.014C9.403 21.59 1.95 14.856 1.95 8.478c0-3.064 2.525-5.754 5.403-5.754 2.137 0 3.776 1.478 4.647 2.822.87-1.344 2.51-2.822 4.647-2.822 2.878 0 5.403 2.69 5.403 5.754 0 6.376-7.454 13.11-10.037 13.157H12z"/></svg>
                                                    <span>{{ tweet.$extras?.likesCount || 0 }}</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            @end
                        </div>
                    @endif

                    <!-- RÉSULTATS - HASHTAGS -->
                    @if((activeTab === 'top' || activeTab === 'hashtags') && hashtags.length > 0)
                        <div class="search-results-section">
                            <h3 class="search-section-title">Hashtags populaires</h3>
                            @each(hashtag in hashtags)
                                <a href="/search/hashtag/{{ hashtag.tag.substring(1) }}" class="search-hashtag-item">
                                    <div>
                                        <div class="hashtag-name">{{ hashtag.tag }}</div>
                                        <div class="hashtag-count">{{ hashtag.count }} posts</div>
                                    </div>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                        <path d="M9 18l6-6-6-6"/>
                                    </svg>
                                </a>
                            @end
                        </div>
                    @endif

                    <!-- AUCUN RÉSULTAT -->
                    @if(users.length === 0 && tweets.length === 0 && hashtags.length === 0)
                        <div class="search-empty">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            <h3>Aucun résultat pour "{{ query }}"</h3>
                            <p>Vérifiez l'orthographe ou essayez d'autres mots-clés.</p>
                        </div>
                    @endif

                @else
                    <!-- PAGE D'ACCUEIL RECHERCHE (pas encore de recherche) -->
                    <div class="search-welcome">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <h3>Rechercher sur Clone-X</h3>
                        <p>Saisissez un mot-clé pour trouver des utilisateurs, des posts ou des hashtags.</p>
                    </div>

                    <!-- Suggestions d'utilisateurs -->
                    @if(suggestions && suggestions.length > 0)
                        <div class="search-suggestions">
                            <h3>Suggestions</h3>
                            @each(user in suggestions)
                                <div class="search-user-item">
                                    <a href="/profile/{{ user.username }}" class="search-user-link">
                                        <div class="search-user-avatar">
                                            @if(user.profile_picture)
                                                <img src="{{ user.profile_picture }}" alt="Avatar">
                                            @else
                                                <div class="avatar-circle-small">
                                                    {{ user.name ? user.name.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase() }}
                                                </div>
                                            @endif
                                        </div>
                                        <div class="search-user-info">
                                            <strong>{{ user.name || user.username }}</strong>
                                            <span class="username">{{ user.username }}</span>
                                        </div>
                                    </a>
                                    <div class="search-user-action">
                                        <form class="follow-form-search" data-user-id="{{ user.id }}" data-following="false">
                                            {{ csrfField() }}
                                            <button type="button" class="follow-btn-search">Suivre</button>
                                        </form>
                                    </div>
                                </div>
                            @end
                        </div>
                    @endif
                @endif
            </div>

            <!-- COLONNE DROITE -->
            <div id="rightContainer">
                <div id="searchWrap">
                    <form action="/search" method="GET">
                        <input class="search__input" name="q" placeholder="Search" />
                    </form>
                </div>

                <div id="subscribe">
                    <span class="subscribe__title">Subscribe to Premium</span>
                    <p class="subscribe__desc">Subscribe to unlock new features and if eligible, receive a share of revenue.</p>
                    <button class="btn--secondary">Subscribe</button>
                </div>
            </div>
        </main>

        <!-- MODALES -->
        <div id="replyModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('replyModal')">&times;</button>
                <h3>Répondre au tweet</h3>
                <form id="replyForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Votre réponse..." maxlength="280" required></textarea>
                    <button type="submit">Répondre</button>
                </form>
            </div>
        </div>

        <div id="retweetModal" class="modal" style="display:none">
            <div class="modal-content">
                <button class="close-modal" onclick="closeModal('retweetModal')">&times;</button>
                <h3>Retweeter</h3>
                <form id="retweetForm" method="POST">
                    {{ csrfField() }}
                    <textarea name="content" placeholder="Ajouter un commentaire (optionnel)"></textarea>
                    <button type="submit">Retweeter</button>
                </form>
            </div>
        </div>
    @end
@end

<style>
/* ========== STYLES RECHERCHE ========== */

.search-header {
    position: sticky;
    top: 0;
    background: white;
    z-index: 30;
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
}

.search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.search-icon {
    position: absolute;
    left: 12px;
    width: 18px;
    height: 18px;
    color: #6b7280;
}

.search-form {
    flex: 1;
}

.search-input {
    width: 100%;
    padding: 12px 40px;
    background: #f3f4f6;
    border: 1px solid transparent;
    border-radius: 9999px;
    font-size: 15px;
    transition: all 0.2s;
}

.search-input:focus {
    outline: none;
    background: white;
    border-color: #1d9bf0;
}

.search-clear {
    position: absolute;
    right: 12px;
    font-size: 24px;
    color: #6b7280;
    text-decoration: none;
    font-weight: bold;
}

.search-clear:hover {
    color: #1d9bf0;
}

/* Onglets */
.search-tabs {
    display: flex;
    border-bottom: 1px solid #e5e7eb;
    background: white;
    position: sticky;
    top: 68px;
    z-index: 29;
}

.search-tab {
    flex: 1;
    text-align: center;
    padding: 16px;
    font-weight: 600;
    color: #6b7280;
    text-decoration: none;
    transition: all 0.2s;
    border-bottom: 4px solid transparent;
}

.search-tab:hover {
    background: rgba(29, 155, 240, 0.1);
    color: #1d9bf0;
}

.search-tab.active {
    color: #1d9bf0;
    border-bottom-color: #1d9bf0;
}

/* Sections résultats */
.search-results-section {
    margin-bottom: 24px;
}

.search-section-title {
    font-size: 18px;
    font-weight: 700;
    padding: 16px;
    margin: 0;
    border-bottom: 1px solid #e5e7eb;
}

/* Élément utilisateur */
.search-user-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    transition: background 0.2s;
}

.search-user-item:hover {
    background: #f9f9f9;
}

.search-user-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    flex: 1;
}

.search-user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
}

.search-user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.avatar-circle-small {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #1d9bf0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 20px;
}

.search-user-info strong {
    display: block;
    color: black;
    font-size: 15px;
}

.search-user-info .username {
    color: #6b7280;
    font-size: 13px;
}

.user-bio {
    color: #4b5563;
    font-size: 13px;
    margin-top: 4px;
}

/* Bouton follow recherche */
.follow-btn-search {
    background: black;
    color: white;
    border: none;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
}

.follow-btn-search:hover {
    background: #1d9bf0;
}

.follow-btn-search.following {
    background: transparent;
    border: 1px solid #e5e7eb;
    color: black;
}

.follow-btn-search.following:hover {
    background: rgba(29, 155, 240, 0.1);
    border-color: #1d9bf0;
    color: #1d9bf0;
}

/* Élément hashtag */
.search-hashtag-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
    text-decoration: none;
    transition: background 0.2s;
}

.search-hashtag-item:hover {
    background: #f9f9f9;
}

.hashtag-name {
    font-weight: 600;
    color: #1d9bf0;
    font-size: 15px;
}

.hashtag-count {
    color: #6b7280;
    font-size: 13px;
    margin-top: 4px;
}

.search-hashtag-item svg {
    color: #6b7280;
}

/* État vide */
.search-empty, .search-welcome {
    text-align: center;
    padding: 60px 32px;
}

.search-empty svg, .search-welcome svg {
    color: #6b7280;
    margin-bottom: 16px;
}

.search-empty h3, .search-welcome h3 {
    font-size: 20px;
    font-weight: 700;
    color: black;
    margin-bottom: 8px;
}

.search-empty p, .search-welcome p {
    color: #6b7280;
}

/* Suggestions */
.search-suggestions {
    margin-top: 24px;
    border-top: 8px solid #f3f4f6;
}

.search-suggestions h3 {
    font-size: 18px;
    font-weight: 700;
    padding: 16px;
    margin: 0;
}

/* Tweet dans les résultats */
.search-tweet-item {
    padding: 16px;
    border-bottom: 1px solid #e5e7eb;
    transition: background 0.2s;
}

.search-tweet-item:hover {
    background: #f9f9f9;
}
</style>

<script>
    let currentReplyId = null;
    let currentRetweetId = null;

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    window.openReplyModal = function(tweetId, element) {
        currentReplyId = tweetId;
        const modal = document.getElementById('replyModal');
        const form = document.getElementById('replyForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/reply`;
            modal.style.display = 'flex';
        }
    };

    window.openRetweetModal = function(tweetId) {
        currentRetweetId = tweetId;
        const modal = document.getElementById('retweetModal');
        const form = document.getElementById('retweetForm');
        if (modal && form) {
            form.action = `/tweets/${tweetId}/retweet`;
            modal.style.display = 'flex';
        }
    };

    // Gestion des likes
    document.querySelectorAll('.like-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const btn = form.querySelector('.like-btn');
            const countSpan = btn.querySelector('span');
            try {
                const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': csrfToken || '' },
                    body: formData
                });
                if (response.ok) {
                    const result = await response.json();
                    if (result.liked) {
                        btn.classList.add('liked');
                    } else {
                        btn.classList.remove('liked');
                    }
                    if (countSpan) countSpan.textContent = result.likesCount;
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        });
    });

    // Gestion du follow
    async function handleFollow(userId, button, isFollowing) {
        const url = `/follow/${userId}`;
        const method = isFollowing ? 'DELETE' : 'POST';
        
        try {
            const csrfToken = document.querySelector('input[name="_csrf"]')?.value;
            const response = await fetch(url, {
                method: method,
                headers: {
                    'X-CSRF-TOKEN': csrfToken || '',
                    'Content-Type': 'application/json'
                }
            });
            
            if (response.ok) {
                if (isFollowing) {
                    button.textContent = 'Suivre';
                    button.classList.remove('following');
                } else {
                    button.textContent = 'Abonné';
                    button.classList.add('following');
                }
                button.setAttribute('data-following', (!isFollowing).toString());
            }
        } catch (error) {
            console.error('Erreur:', error);
        }
    }

    document.querySelectorAll('.follow-form-search').forEach(form => {
        const button = form.querySelector('button');
        const userId = form.dataset.userId;
        const isFollowing = form.dataset.following === 'true';
        
        button.addEventListener('click', async () => {
            await handleFollow(userId, button, isFollowing);
        });
    });

    // Menu utilisateur
    const menuBtn = document.querySelector('.user-menu');
    const popupMenu = document.querySelector('.popup-menu');
    if (menuBtn && popupMenu) {
        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            popupMenu.classList.toggle('hidden');
        });
        document.addEventListener('click', () => popupMenu.classList.add('hidden'));
    }
</script>